<Project>
  <Import Project="$(CamelVcpkgMsbuild)vcpkg.targets" Condition="'$(VcpkgPropsImported)' == 'true' and Exists('$(CamelVcpkgMsbuild)vcpkg.targets')" />
  <Target Name="CopyOpenCCData" AfterTargets="Build" Condition="'$(ConfigurationType)' == 'Application'">
    <ItemGroup>
      <OpenCCData Include="$(VcpkgInstalledDir)$(VcpkgTriplet)\share\opencc\*.json;$(VcpkgInstalledDir)$(VcpkgTriplet)\share\opencc\*.ocd2" />
    </ItemGroup>
    <Copy SourceFiles="@(OpenCCData)" DestinationFolder="$(OutDir)opencc\" SkipUnchangedFiles="true" />
  </Target>
</Project>
