                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <FontIcon Glyph="&#xE765;" FontSize="20" />
                                    <TextBlock x:Uid="Settings_Hotkeys" Style="{StaticResource CardHeaderStyle}" />
                                </StackPanel>
                                <TextBlock x:Uid="Settings_HotkeysText" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <StackPanel x:Name="HotkeyRows" Spacing="8" />
                                <Button x:Uid="Settings_HotkeysDefaults" Click="OnHotkeyDefaultsClick" />
