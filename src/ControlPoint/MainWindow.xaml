                                </StackPanel>
                                <ComboBox x:Name="DecoderCombo" x:Uid="Settings_Decoder" Width="360" SelectionChanged="OnSettingChanged" />
                                <ComboBox x:Name="WavDecoderCombo" x:Uid="Settings_WavDecoder" Width="360" SelectionChanged="OnSettingChanged" />
                                <ComboBox x:Name="AiffDecoderCombo" x:Uid="Settings_AiffDecoder" Width="360" SelectionChanged="OnSettingChanged" />
                            </StackPanel>
                        </Border>

                        <Border x:Name="InterfaceCard" Style="{StaticResource SettingsCardStyle}">
                            <StackPanel Spacing="12">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <FontIcon Glyph="&#xE771;" FontSize="20" />
                                    <TextBlock x:Uid="Settings_Interface" Style="{StaticResource CardHeaderStyle}" />
                                </StackPanel>
                                <ComboBox x:Name="LanguageCombo" x:Uid="Settings_Language" Width="360" SelectionChanged="OnLanguageChanged" />
                                <ComboBox x:Name="ThemeCombo" x:Uid="Settings_Theme" Width="360" SelectionChanged="OnSettingChanged" />
                                <ComboBox x:Name="CloseActionCombo" x:Uid="Settings_CloseAction" Width="360" SelectionChanged="OnSettingChanged" />
                                <ToggleSwitch x:Name="AutoUpdateSwitch" x:Uid="Settings_AutoUpdate" Toggled="OnUpdateSwitchToggled" />
                                <ToggleSwitch x:Name="ArtistPicturesSwitch" x:Uid="Settings_ArtistPictures" Toggled="OnArtistPicturesToggled" />
