                    <SolidColorBrush x:Key="ButtonBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
                    <SolidColorBrush x:Key="ToggleButtonBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="ToggleButtonBorderBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="ToggleButtonBorderBrushPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="ToggleButtonBorderBrushPressed" Color="Transparent" />
                    <Style x:Key="TransportButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                        <Setter Property="Width" Value="40" />
                        <Setter Property="Height" Value="40" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="CornerRadius" Value="20" />
                    </Style>
                    <Style x:Key="TransportToggleStyle" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
                        <Setter Property="Width" Value="40" />
                        <Setter Property="Height" Value="40" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="CornerRadius" Value="20" />
                    </Style>
                </Grid.Resources>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0" ColumnSpacing="8" MinWidth="0" SizeChanged="OnArtistCreditSizeChanged">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="68" />
                        <ColumnDefinition x:Name="PlayerTextColumn" Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="CoverButton" x:Uid="Player_Cover" Click="OnCoverClick" Padding="0"
                            Background="Transparent" BorderThickness="0" VerticalAlignment="Center">
                        <Grid Width="60" Height="60">
                            <FontIcon Glyph="&#xE93C;" FontSize="28" Opacity="0.4" />
                            <Image x:Name="PlaybackCover" Width="60" Height="60" Stretch="Uniform" />
                        </Grid>
                    </Button>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1" HorizontalAlignment="Stretch">
                        <StackPanel.Resources>
                            <ResourceDictionary>
                                <ResourceDictionary.ThemeDictionaries>
                                    <ResourceDictionary x:Key="Default">
                                        <StaticResource x:Key="HyperlinkButtonForeground" ResourceKey="TextFillColorSecondaryBrush" />
                                        <StaticResource x:Key="HyperlinkButtonForegroundPointerOver" ResourceKey="TextFillColorPrimaryBrush" />
                                        <StaticResource x:Key="HyperlinkButtonForegroundPressed" ResourceKey="TextFillColorTertiaryBrush" />
                                    </ResourceDictionary>
                                    <ResourceDictionary x:Key="Light">
                                        <StaticResource x:Key="HyperlinkButtonForeground" ResourceKey="TextFillColorSecondaryBrush" />
                                        <StaticResource x:Key="HyperlinkButtonForegroundPointerOver" ResourceKey="TextFillColorPrimaryBrush" />
                                        <StaticResource x:Key="HyperlinkButtonForegroundPressed" ResourceKey="TextFillColorTertiaryBrush" />
                                    </ResourceDictionary>
                                </ResourceDictionary.ThemeDictionaries>
                            </ResourceDictionary>
                        </StackPanel.Resources>
                        <TextBlock x:Name="TitleText" TextTrimming="CharacterEllipsis" IsTextTrimmedChanged="OnTextTrimmedChanged" TextWrapping="NoWrap"
                                   MaxLines="1" FontSize="14" FontWeight="SemiBold" />
                        <!-- Each name in the artist credit opens that artist. -->
                        <StackPanel x:Name="ArtistCredit" Orientation="Horizontal" Visibility="Collapsed">
                            <StackPanel.Resources>
                                <Style x:Key="CreditSeparatorStyle" TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                </Style>
                            </StackPanel.Resources>
                        </StackPanel>
                        <HyperlinkButton x:Name="AlbumLink" Click="OnAlbumLinkClick" Padding="0"
                                         HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Visibility="Collapsed">
                            <TextBlock x:Name="AlbumLinkText" TextTrimming="CharacterEllipsis" IsTextTrimmedChanged="OnTextTrimmedChanged" TextWrapping="NoWrap" MaxLines="1" FontSize="12" />
                        </HyperlinkButton>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="16,0,0,0">
                        <ToggleButton x:Name="ShuffleButton" Click="OnShuffleClick" Style="{StaticResource TransportToggleStyle}">
                            <SymbolIcon Symbol="Shuffle" />
                        </ToggleButton>
                        <Button x:Name="StopButton" Click="OnStopClick" Style="{StaticResource TransportButtonStyle}">
                            <SymbolIcon Symbol="Stop" />
                        </Button>
                        <Button x:Name="PreviousButton" Click="OnPreviousClick" Style="{StaticResource TransportButtonStyle}">
                            <SymbolIcon Symbol="Previous" />
                        </Button>
                    </StackPanel>
                </Grid>
                <Button x:Name="PlayPauseButton" Grid.Column="1" Click="OnPlayPauseClick" Style="{StaticResource AccentButtonStyle}"
                        Width="48" Height="48" Padding="0" CornerRadius="24" VerticalAlignment="Center">
                    <SymbolIcon x:Name="PlayPauseIcon" Symbol="Play" />
                </Button>
                <Grid Grid.Column="2" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button x:Name="NextButton" Click="OnNextClick" Style="{StaticResource TransportButtonStyle}">
                            <SymbolIcon Symbol="Next" />
                        </Button>
                        <ToggleButton x:Name="RepeatButton" Click="OnRepeatClick" Style="{StaticResource TransportToggleStyle}">
                            <SymbolIcon x:Name="RepeatIcon" Symbol="RepeatAll" />
                        </ToggleButton>
                    </StackPanel>
                    <!-- Playback state, bit-perfect indicator and source badges (docs/Plan.md §5.2, §8.1) beside the
                         volume; where they do not fit, the state badge and the lamp's words give way, and the lamp opens the
                         signal path. The row makes buttons transparent, so these set the badge look themselves. -->
                    <Grid x:Name="StatusArea" Grid.Column="1" SizeChanged="OnStatusAreaSizeChanged">
                        <StackPanel x:Name="StatusBadges" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                            <Border x:Name="StateBadge" Style="{StaticResource BadgeStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon x:Name="StateIcon" Glyph="&#xE71A;" FontSize="10" VerticalAlignment="Center" />
                                    <TextBlock x:Name="StateText" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center"
                                               AutomationProperties.LiveSetting="Polite" />
                                </StackPanel>
                            </Border>
                            <!-- The lamp opens the signal path. -->
                            <Button x:Name="LampButton" x:Uid="SignalPath_Lamp" Padding="10,2" MinHeight="32"
                                    CornerRadius="16" VerticalAlignment="Center"
                                    Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Ellipse x:Name="Lamp" Width="8" Height="8" VerticalAlignment="Center"
                                             Fill="{ThemeResource ControlStrongFillColorDisabledBrush}" />
                                    <TextBlock x:Name="LampText" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold"
                                               VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
                                </StackPanel>
                                <!-- The signal path floats above the bar: the verdict and the route, then the steps by stage. -->
                                <Button.Flyout>
                                    <Flyout x:Name="SignalPathFlyout" Placement="TopEdgeAlignedRight">
                                        <StackPanel x:Uid="SignalPath_Panel" Width="380" Spacing="12">
                                            <StackPanel Spacing="2">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <Ellipse x:Name="PathVerdictDot" Width="10" Height="10" VerticalAlignment="Center" />
                                                    <TextBlock x:Name="PathVerdictText" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                                </StackPanel>
                                                <TextBlock x:Name="PathRouteText" Style="{StaticResource CaptionTextBlockStyle}" Margin="18,0,0,0"
                                                           TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                            <Border x:Name="PathDivider" Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                                                    Visibility="Collapsed" />
                                            <Grid x:Name="SignalPathGrid" ColumnSpacing="12" Visibility="Collapsed">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                            </Grid>
                                            <TextBlock x:Name="SignalNoteText" Style="{StaticResource CaptionTextBlockStyle}" IsTextSelectionEnabled="True"
                                                       TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                            <Border x:Name="SourceBadge" Style="{StaticResource BadgeStyle}" Visibility="Collapsed">
                                <TextBlock x:Uid="Badge_Lossy" Style="{StaticResource CaptionTextBlockStyle}" />
                            </Border>
                            <Border x:Name="BypassBadge" Style="{StaticResource BadgeStyle}" Visibility="Collapsed">
                                <TextBlock x:Name="BypassText" Style="{StaticResource CaptionTextBlockStyle}" />
                            </Border>
                            <!-- Turns each DSP node on or off and switches EQ presets; accented while the chain changes the signal. -->
                            <Button x:Name="DspButton" x:Uid="Dsp_Button" Padding="10,2" MinHeight="32" CornerRadius="16" VerticalAlignment="Center"
                                    Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}">
                                <TextBlock x:Name="DspButtonText" Text="DSP" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold" />
                                <Button.Flyout>
                                    <MenuFlyout x:Name="DspMenu" Placement="Top" Opening="OnDspMenuOpening" />
                                </Button.Flyout>
                            </Button>
                        </StackPanel>
                    </Grid>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <!-- The enabled outputs (docs/Plan.md §8.1), the one in use checked. -->
                        <Button x:Name="OutputButton" x:Uid="Output_Button" Style="{StaticResource TransportButtonStyle}">
                            <FontIcon Glyph="&#xE7F5;" />
                            <Button.Flyout>
                                <MenuFlyout x:Name="OutputMenu" Placement="Top" Opening="OnOutputMenuOpening" />
                            </Button.Flyout>
                        </Button>
                        <!-- Volume (docs/Plan.md §5.9): fixed volume shows a lock and says who sets the level; software volume
                             opens a vertical slider with mute, and the wheel over the button moves it 1 dB a notch. -->
                        <Button x:Name="VolumeButton" Style="{StaticResource TransportButtonStyle}" PointerWheelChanged="OnVolumeWheel">
                            <Grid>
                                <FontIcon x:Name="VolumeIcon" Glyph="&#xE767;" />
                                <FontIcon x:Name="VolumeLock" Glyph="&#xE72E;" FontSize="9" HorizontalAlignment="Right"
                                          VerticalAlignment="Bottom" Margin="0,0,-6,-4" />
                            </Grid>
                            <Button.Flyout>
                                <Flyout x:Name="VolumeFlyout" Placement="Top">
                                    <Grid>
                                        <StackPanel x:Name="FixedVolumePanel" Width="240" Spacing="4">
                                            <TextBlock x:Name="FixedVolumeTitle" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                            <TextBlock x:Uid="Volume_FixedNote" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <HyperlinkButton x:Uid="Volume_Settings" Padding="0" Margin="0,4,0,0" Click="OnVolumeSettingsClick" />
                                        </StackPanel>
                                        <StackPanel x:Name="SoftwareVolumePanel" Spacing="8" HorizontalAlignment="Center">
                                            <TextBlock x:Name="VolumeText" Style="{StaticResource CaptionTextBlockStyle}" HorizontalAlignment="Center" />
                                            <Slider x:Name="VolumeSlider" x:Uid="Volume_Slider" Orientation="Vertical" Height="160" Minimum="-80"
                                                    Maximum="0" StepFrequency="0.5" SmallChange="1" LargeChange="6" HorizontalAlignment="Center"
                                                    ValueChanged="OnVolumeChanged" PointerWheelChanged="OnVolumeWheel" />
                                            <Button x:Name="MuteButton" Click="OnMuteClick" Width="40" Height="40" Padding="0" CornerRadius="20"
                                                    HorizontalAlignment="Center">
                                                <FontIcon x:Name="MuteIcon" Glyph="&#xE767;" FontSize="16" />
                                            </Button>
                                        </StackPanel>
                                        <StackPanel x:Name="PlayerVolumePanel" Spacing="8" HorizontalAlignment="Center" Visibility="Collapsed">
                                            <TextBlock x:Name="PlayerVolumeText" Style="{StaticResource CaptionTextBlockStyle}" HorizontalAlignment="Center" />
                                            <Slider x:Name="PlayerVolumeSlider" x:Uid="Volume_Slider" Orientation="Vertical" Height="160" Minimum="0"
                                                    Maximum="100" StepFrequency="1" SmallChange="1" LargeChange="5" HorizontalAlignment="Center"
                                                    ValueChanged="OnPlayerVolumeChanged" PointerWheelChanged="OnVolumeWheel" />
                                            <Button x:Name="PlayerMuteButton" Click="OnPlayerMuteClick" Width="40" Height="40" Padding="0" CornerRadius="20"
                                                    HorizontalAlignment="Center">
                                                <FontIcon x:Name="PlayerMuteIcon" Glyph="&#xE767;" FontSize="16" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                        <Button x:Name="PlaybackFavoriteButton" x:Uid="Marks_FavoriteButton" Click="OnPlaybackFavoriteClick" IsEnabled="False"
                                Width="48" Height="48" Padding="0" CornerRadius="24" VerticalAlignment="Center">
                            <FontIcon x:Name="PlaybackFavoriteIcon" Glyph="&#xE006;" FontSize="20" />
                        </Button>
                        <ToggleButton x:Name="QueueToggleButton" Click="OnQueueToggleClick"
                                      Style="{StaticResource TransportToggleStyle}" VerticalAlignment="Center">
                            <SymbolIcon Symbol="Bullets" />
                        </ToggleButton>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
