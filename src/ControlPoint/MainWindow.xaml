                                <ToggleSwitch x:Name="DiscordCoversSwitch" x:Uid="Settings_DiscordCovers" Toggled="OnDiscordToggled" />
                                <TextBlock x:Uid="Settings_DiscordCoversNote" TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="DiscordStatusText" TextWrapping="Wrap" Visibility="Collapsed"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <ToggleSwitch x:Name="FolderTreeSwitch" x:Uid="Settings_FolderTree" Toggled="OnFolderTreeToggled" />
                                <Button x:Uid="Settings_Guide" Click="OnGuideClick" />
                            </StackPanel>
                        </Border>

                        <!-- Global hotkeys (docs/Plan.md §8.4): click a combination, then press the new one. -->
                        <Border x:Name="HotkeysCard" Style="{StaticResource SettingsCardStyle}">
