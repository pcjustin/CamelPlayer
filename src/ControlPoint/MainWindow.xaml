<!-- Main window: navigation shell, settings and full-width playback bar. -->
<Window
    x:Class="CamelPlayer.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CamelPlayer"
    Title="CamelPlayer">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid KeyboardAcceleratorPlacementMode="Hidden" PreviewKeyDown="OnWindowKeyDown">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="OnSearchAccelerator" />
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <NavigationView x:Name="Nav" PaneDisplayMode="Left" OpenPaneLength="200" IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="True" SelectionChanged="OnNavSelectionChanged">
            <!-- Search on every page (docs/Plan.md §8.2): grouped suggestions while typing, Enter opens all results. -->
            <NavigationView.AutoSuggestBox>
                <AutoSuggestBox x:Name="SearchBox" x:Uid="Search_Box" QueryIcon="Find" UpdateTextOnSelect="False"
                                TextChanged="OnSearchTextChanged" QuerySubmitted="OnSearchQuerySubmitted">
                    <AutoSuggestBox.ItemTemplate>
                        <DataTemplate x:DataType="local:BrowseItem">
                            <Grid ColumnSpacing="12" Padding="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{x:Bind Title, Mode=OneWay}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                    <TextBlock Text="{x:Bind Subtitle, Mode=OneWay}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{x:Bind Trailing, Mode=OneWay}" VerticalAlignment="Center"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>
                        </DataTemplate>
                    </AutoSuggestBox.ItemTemplate>
                </AutoSuggestBox>
            </NavigationView.AutoSuggestBox>
            <NavigationView.MenuItems>
                <NavigationViewItem x:Uid="Nav_Home" Tag="home" Icon="Home" />
                <NavigationViewItem x:Uid="Nav_Stats" Tag="stats">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D2;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="Nav_Albums" Tag="albums" Icon="Library" />
                <NavigationViewItem x:Uid="Nav_Artists" Tag="artists" Icon="People" />
                <NavigationViewItem x:Uid="Nav_Composers" Tag="composers" Icon="Edit" />
                <NavigationViewItem x:Uid="Nav_Genres" Tag="genres" Icon="Tag" />
                <NavigationViewItem x:Uid="Nav_Years" Tag="years" Icon="Calendar" />
                <NavigationViewItem x:Uid="Nav_Tracks" Tag="tracks" Icon="List" />
                <NavigationViewItem x:Uid="Nav_Folders" Tag="folders" Icon="Folder" />
                <NavigationViewItemSeparator />
                <NavigationViewItem x:Name="PlaylistsNav" x:Uid="Nav_Playlists" Tag="playlists" Icon="MusicInfo" />
                <NavigationViewItem x:Uid="Nav_SmartPlaylists" Tag="smart" Icon="Favorite" SelectsOnInvoked="False">
                    <NavigationViewItem.MenuItems>
                        <NavigationViewItem x:Uid="Nav_SmartAdded" Tag="smart:added">
                            <NavigationViewItem.Icon><FontIcon Glyph="&#xE710;" /></NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem x:Uid="Nav_SmartMostPlayed" Tag="smart:mostPlayed">
                            <NavigationViewItem.Icon><FontIcon Glyph="&#xE8D6;" /></NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem x:Uid="Nav_SmartRecentlyPlayed" Tag="smart:recentlyPlayed">
                            <NavigationViewItem.Icon><FontIcon Glyph="&#xE81C;" /></NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem x:Uid="Nav_SmartFavorites" Tag="smart:favorites">
                            <NavigationViewItem.Icon><FontIcon Glyph="&#xE00B;" /></NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem x:Uid="Nav_SmartFavoriteAlbums" Tag="smart:favoriteAlbums">
                            <NavigationViewItem.Icon><FontIcon Glyph="&#xE93C;" /></NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem x:Uid="Nav_SmartNeverPlayed" Tag="smart:neverPlayed">
                            <NavigationViewItem.Icon><FontIcon Glyph="&#xE7C1;" /></NavigationViewItem.Icon>
                        </NavigationViewItem>
                    </NavigationViewItem.MenuItems>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Grid x:Name="ContentLayout" ColumnSpacing="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="QueueColumn" Width="0" />
                </Grid.ColumnDefinitions>
            <Grid Padding="32,24,32,16">

                <local:HomeView x:Name="Home" Visibility="Collapsed" />
                <local:StatisticsView x:Name="Stats" Visibility="Collapsed" />
                <local:LibraryView x:Name="Library" Visibility="Collapsed" />
                <local:PlaylistView x:Name="Playlists" Visibility="Collapsed" />

                <!-- Pages of later versions (smart playlists) -->
                <StackPanel x:Name="PlaceholderPanel" Spacing="8" Visibility="Collapsed">
                    <TextBlock x:Name="PlaceholderTitle" Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock x:Uid="Placeholder_Text" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>

                <!-- Settings (docs/Plan.md §6, §8.2): one card per area; rarely changed timing values sit in expanders. -->
                <ScrollViewer x:Name="SettingsPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="16" MaxWidth="820" HorizontalAlignment="Left" Padding="0,0,16,24">
                        <StackPanel.Resources>
                            <Style x:Key="SettingsCardStyle" TargetType="Border">
                                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                                <Setter Property="BorderThickness" Value="1" />
                                <Setter Property="CornerRadius" Value="8" />
                                <Setter Property="Padding" Value="20,16" />
                            </Style>
                            <Style x:Key="CardHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource SubtitleTextBlockStyle}">
                                <Setter Property="VerticalAlignment" Value="Center" />
                            </Style>
                            <Style x:Key="GroupHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                                <Setter Property="Margin" Value="0,4,0,0" />
                            </Style>
                            <Style x:Key="StatusLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
                                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Style>
                            <Style x:Key="StatusValueStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
                                <Setter Property="IsTextSelectionEnabled" Value="True" />
                                <Setter Property="TextWrapping" Value="Wrap" />
                            </Style>
                        </StackPanel.Resources>
                        <TextBlock x:Uid="Settings_Title" Style="{StaticResource TitleTextBlockStyle}" />

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel Spacing="12">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <FontIcon Glyph="&#xE8F1;" FontSize="20" />
                                    <TextBlock x:Uid="Settings_Library" Style="{StaticResource CardHeaderStyle}" />
                                </StackPanel>
                                <ListView x:Name="RootList" SelectionMode="Single" MaxHeight="240" CornerRadius="4"
                                          BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" />
                                <TextBlock x:Name="ScanText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                                           Visibility="Collapsed" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button x:Uid="Settings_AddFolder" Click="OnAddFolderClick" Style="{StaticResource AccentButtonStyle}" />
                                    <Button x:Uid="Settings_RemoveFolder" Click="OnRemoveFolderClick" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel Spacing="12">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <FontIcon Glyph="&#xE7F5;" FontSize="20" />
                                    <TextBlock x:Uid="Settings_Playback" Style="{StaticResource CardHeaderStyle}" />
                                </StackPanel>
                                <ComboBox x:Name="BackendCombo" x:Uid="Settings_Backend" Width="360" SelectionChanged="OnSettingChanged" />
                                <InfoBar x:Name="BackendNotice" Severity="Warning" IsOpen="False" IsClosable="True" />
                                <ComboBox x:Name="ConvertCombo" x:Uid="Settings_Convert" Width="520" SelectionChanged="OnSettingChanged" />
                                <ComboBox x:Name="ResampleQualityCombo" x:Uid="Settings_ResampleQuality" Width="360" SelectionChanged="OnSettingChanged" />
                                <ToggleSwitch x:Name="AutoplaySwitch" x:Uid="Settings_Autoplay" Toggled="OnAutoplayToggled" />

                                <StackPanel x:Name="WasapiGroup" Spacing="12">
                                    <TextBlock Text="WASAPI" Style="{StaticResource GroupHeaderStyle}" />
                                    <ComboBox x:Name="WasapiDeviceCombo" x:Uid="Settings_Device" Width="520" SelectionChanged="OnSettingChanged" />
                                    <ComboBox x:Name="WasapiShareCombo" x:Uid="Settings_WasapiShare" Width="360" SelectionChanged="OnSettingChanged" />
                                    <ComboBox x:Name="WasapiSharedQualityCombo" x:Uid="Settings_WasapiSharedQuality" Width="360" SelectionChanged="OnSettingChanged" />
                                    <ComboBox x:Name="WasapiModeCombo" x:Uid="Settings_WasapiMode" Width="360" SelectionChanged="OnSettingChanged" />
                                    <ComboBox x:Name="WasapiFormatCombo" x:Uid="Settings_SampleFormat" Width="360" SelectionChanged="OnSettingChanged" />
                                    <ComboBox x:Name="WasapiRateCombo" x:Uid="Settings_FixedRate" Width="360" SelectionChanged="OnSettingChanged" />
                                    <Expander x:Uid="Settings_Advanced" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                                        <StackPanel Spacing="12">
                                            <ComboBox x:Name="WasapiPeriodCombo" x:Uid="Settings_Period" Width="360" SelectionChanged="OnSettingChanged" />
                                            <NumberBox x:Name="WasapiPeriodBox" x:Uid="Settings_PeriodMs" Width="200" HorizontalAlignment="Left" Minimum="1" Maximum="500"
                                                       SpinButtonPlacementMode="Compact" ValueChanged="OnNumberChanged" />
                                            <NumberBox x:Name="WasapiPollBufferBox" x:Uid="Settings_PollBuffer" Width="200" HorizontalAlignment="Left" Minimum="20" Maximum="2000"
                                                       SpinButtonPlacementMode="Compact" ValueChanged="OnNumberChanged" />
                                            <ComboBox x:Name="WasapiMmcssTaskCombo" x:Uid="Settings_MmcssTask" Width="360" SelectionChanged="OnSettingChanged" />
                                            <ComboBox x:Name="WasapiMmcssPriorityCombo" x:Uid="Settings_MmcssPriority" Width="360" SelectionChanged="OnSettingChanged" />
                                            <NumberBox x:Name="WasapiPredecodeBox" x:Uid="Settings_Predecode" Width="320" HorizontalAlignment="Left" Minimum="1" Maximum="60"
                                                       SpinButtonPlacementMode="Compact" ValueChanged="OnNumberChanged" />
                                            <NumberBox x:Name="WasapiSilenceBox" x:Uid="Settings_FormatSilence" Width="320" HorizontalAlignment="Left" Minimum="0" Maximum="2000"
                                                       SpinButtonPlacementMode="Compact" ValueChanged="OnNumberChanged" />
                                            <NumberBox x:Name="WasapiReleaseBox" x:Uid="Settings_ReleaseAfterPause" Width="320" HorizontalAlignment="Left" Minimum="0" Maximum="3600"
                                                       SpinButtonPlacementMode="Compact" ValueChanged="OnNumberChanged" />
                                        </StackPanel>
                                    </Expander>
                                </StackPanel>

                                <StackPanel x:Name="AsioGroup" Spacing="12">
                                    <TextBlock Text="ASIO" Style="{StaticResource GroupHeaderStyle}" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <ComboBox x:Name="AsioDriverCombo" x:Uid="Settings_AsioDriver" Width="520" SelectionChanged="OnSettingChanged" />
                                        <Button x:Uid="Settings_AsioPanel" Click="OnAsioPanelClick" VerticalAlignment="Bottom" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <NumberBox x:Name="AsioLeftBox" x:Uid="Settings_AsioLeft" Width="160" Minimum="1" Maximum="64"
                                                   SpinButtonPlacementMode="Compact" ValueChanged="OnNumberChanged" />
                                        <NumberBox x:Name="AsioRightBox" x:Uid="Settings_AsioRight" Width="160" Minimum="1" Maximum="64"
                                                   SpinButtonPlacementMode="Compact" ValueChanged="OnNumberChanged" />
                                    </StackPanel>
                                    <ComboBox x:Name="AsioRateCombo" x:Uid="Settings_FixedRate" Width="360" SelectionChanged="OnSettingChanged" />
                                    <Expander x:Uid="Settings_Advanced" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                                        <StackPanel Spacing="12">
                                            <NumberBox x:Name="AsioBufferBox" x:Uid="Settings_AsioBuffer" Width="200" HorizontalAlignment="Left" Minimum="0" Maximum="65536"
                                                       SpinButtonPlacementMode="Compact" ValueChanged="OnNumberChanged" />
                                            <NumberBox x:Name="AsioPredecodeBox" x:Uid="Settings_Predecode" Width="320" HorizontalAlignment="Left" Minimum="1" Maximum="60"
                                                       SpinButtonPlacementMode="Compact" ValueChanged="OnNumberChanged" />
                                            <NumberBox x:Name="AsioSilenceBox" x:Uid="Settings_FormatSilence" Width="320" HorizontalAlignment="Left" Minimum="0" Maximum="2000"
                                                       SpinButtonPlacementMode="Compact" ValueChanged="OnNumberChanged" />
                                            <NumberBox x:Name="AsioReleaseBox" x:Uid="Settings_ReleaseAfterPause" Width="320" HorizontalAlignment="Left" Minimum="0" Maximum="3600"
                                                       SpinButtonPlacementMode="Compact" ValueChanged="OnNumberChanged" />
                                        </StackPanel>
                                    </Expander>
                                </StackPanel>

                                <StackPanel x:Name="KsGroup" Spacing="12">
                                    <TextBlock Text="Kernel Streaming" Style="{StaticResource GroupHeaderStyle}" />
                                    <ComboBox x:Name="KsDeviceCombo" x:Uid="Settings_Device" Width="520" SelectionChanged="OnSettingChanged" />
                                    <ComboBox x:Name="KsModeCombo" x:Uid="Settings_KsMode" Width="360" SelectionChanged="OnSettingChanged" />
                                    <ComboBox x:Name="KsFormatCombo" x:Uid="Settings_SampleFormat" Width="360" SelectionChanged="OnSettingChanged" />
                                    <ComboBox x:Name="KsRateCombo" x:Uid="Settings_FixedRate" Width="360" SelectionChanged="OnSettingChanged" />
                                    <Expander x:Uid="Settings_Advanced" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                                        <StackPanel Spacing="12">
                                            <NumberBox x:Name="KsBufferBox" x:Uid="Settings_KsBuffer" Width="200" HorizontalAlignment="Left" Minimum="2" Maximum="1000"
                                                       SpinButtonPlacementMode="Compact" ValueChanged="OnNumberChanged" />
                                            <StackPanel Orientation="Horizontal" Spacing="12">
                                                <NumberBox x:Name="KsPacketCountBox" x:Uid="Settings_KsPacketCount" Width="160" Minimum="2" Maximum="16"
                                                           SpinButtonPlacementMode="Compact" ValueChanged="OnNumberChanged" />
                                                <NumberBox x:Name="KsPacketMsBox" x:Uid="Settings_KsPacketMs" Width="160" Minimum="1" Maximum="200"
                                                           SpinButtonPlacementMode="Compact" ValueChanged="OnNumberChanged" />
                                            </StackPanel>
                                            <ComboBox x:Name="KsMmcssTaskCombo" x:Uid="Settings_MmcssTask" Width="360" SelectionChanged="OnSettingChanged" />
                                            <ComboBox x:Name="KsMmcssPriorityCombo" x:Uid="Settings_MmcssPriority" Width="360" SelectionChanged="OnSettingChanged" />
                                            <NumberBox x:Name="KsPredecodeBox" x:Uid="Settings_Predecode" Width="320" HorizontalAlignment="Left" Minimum="1" Maximum="60"
                                                       SpinButtonPlacementMode="Compact" ValueChanged="OnNumberChanged" />
                                            <NumberBox x:Name="KsSilenceBox" x:Uid="Settings_FormatSilence" Width="320" HorizontalAlignment="Left" Minimum="0" Maximum="2000"
                                                       SpinButtonPlacementMode="Compact" ValueChanged="OnNumberChanged" />
                                            <NumberBox x:Name="KsReleaseBox" x:Uid="Settings_ReleaseAfterPause" Width="320" HorizontalAlignment="Left" Minimum="0" Maximum="3600"
                                                       SpinButtonPlacementMode="Compact" ValueChanged="OnNumberChanged" />
                                        </StackPanel>
                                    </Expander>
                                    <TextBlock x:Uid="Settings_KsNote" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>

                                <TextBlock x:Uid="Settings_ApplyNote" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <Button x:Uid="Settings_Refresh" Click="OnRefreshDevicesClick" />
                            </StackPanel>
                        </Border>

                        <!-- Status area (read-only, docs/Plan.md §6) -->
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel Spacing="12">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <FontIcon Glyph="&#xE9D9;" FontSize="20" />
                                    <TextBlock x:Uid="Settings_Status" Style="{StaticResource CardHeaderStyle}" />
                                </StackPanel>
                                <StackPanel x:Name="StatusNotices" Spacing="8" />
                                <TextBlock x:Name="StatusIdleText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                <Grid x:Name="StatusGrid" ColumnSpacing="24" RowSpacing="8" Visibility="Collapsed">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock x:Uid="Status_Output" Style="{StaticResource StatusLabelStyle}" />
                                    <TextBlock x:Name="StatusOutputText" Grid.Column="1" Style="{StaticResource StatusValueStyle}" />
                                    <TextBlock x:Uid="Status_Mode" Grid.Row="1" Style="{StaticResource StatusLabelStyle}" />
                                    <TextBlock x:Name="StatusModeText" Grid.Row="1" Grid.Column="1" Style="{StaticResource StatusValueStyle}" />
                                    <TextBlock x:Uid="Status_Buffer" Grid.Row="2" Style="{StaticResource StatusLabelStyle}" />
                                    <TextBlock x:Name="StatusBufferText" Grid.Row="2" Grid.Column="1" Style="{StaticResource StatusValueStyle}" />
                                    <TextBlock x:Uid="Status_Underruns" Grid.Row="3" Style="{StaticResource StatusLabelStyle}" />
                                    <TextBlock x:Name="StatusUnderrunText" Grid.Row="3" Grid.Column="1" Style="{StaticResource StatusValueStyle}" />
                                    <TextBlock x:Uid="Status_Details" Grid.Row="4" Style="{StaticResource StatusLabelStyle}" />
                                    <TextBlock x:Name="StatusDetailText" Grid.Row="4" Grid.Column="1" Style="{StaticResource StatusValueStyle}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel Spacing="12">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <FontIcon Glyph="&#xE9E9;" FontSize="20" />
                                    <TextBlock x:Uid="Settings_Decoders" Style="{StaticResource CardHeaderStyle}" />
                                </StackPanel>
                                <ComboBox x:Name="DecoderCombo" x:Uid="Settings_Decoder" Width="360" SelectionChanged="OnSettingChanged" />
                                <ComboBox x:Name="AlacDecoderCombo" x:Uid="Settings_AlacDecoder" Width="360" SelectionChanged="OnSettingChanged" />
                                <ComboBox x:Name="WavDecoderCombo" x:Uid="Settings_WavDecoder" Width="360" SelectionChanged="OnSettingChanged" />
                                <ComboBox x:Name="AiffDecoderCombo" x:Uid="Settings_AiffDecoder" Width="360" SelectionChanged="OnSettingChanged" />
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <ComboBox x:Name="AacDecoderCombo" x:Uid="Settings_AacDecoder" Width="240" SelectionChanged="OnSettingChanged" />
                                    <ComboBox x:Name="AacBitsCombo" x:Uid="Settings_AacBits" Width="240" SelectionChanged="OnSettingChanged" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <ComboBox x:Name="Mp3DecoderCombo" x:Uid="Settings_Mp3Decoder" Width="240" SelectionChanged="OnSettingChanged" />
                                    <ComboBox x:Name="Mp3BitsCombo" x:Uid="Settings_Mp3Bits" Width="240" SelectionChanged="OnSettingChanged" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel Spacing="12">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <FontIcon Glyph="&#xE771;" FontSize="20" />
                                    <TextBlock x:Uid="Settings_Interface" Style="{StaticResource CardHeaderStyle}" />
                                </StackPanel>
                                <ComboBox x:Name="LanguageCombo" x:Uid="Settings_Language" Width="360" SelectionChanged="OnLanguageChanged" />
                                <ComboBox x:Name="CloseActionCombo" x:Uid="Settings_CloseAction" Width="360" SelectionChanged="OnSettingChanged" />
                                <Button x:Uid="Settings_Guide" Click="OnGuideClick" />
                                <TextBlock x:Name="LanguageNote" x:Uid="Settings_LanguageNote" Visibility="Collapsed" TextWrapping="Wrap"
                                           Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                            </StackPanel>
                        </Border>

                        <!-- Global hotkeys (docs/Plan.md §8.4): click a combination, then press the new one. -->
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel Spacing="12">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <FontIcon Glyph="&#xE765;" FontSize="20" />
                                    <TextBlock x:Uid="Settings_Hotkeys" Style="{StaticResource CardHeaderStyle}" />
                                </StackPanel>
                                <TextBlock x:Uid="Settings_HotkeysText" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <StackPanel x:Name="HotkeyRows" Spacing="8" />
                                <Button x:Uid="Settings_HotkeysDefaults" Click="OnHotkeyDefaultsClick" />
                                <TextBlock x:Uid="Settings_WindowKeys" Style="{StaticResource GroupHeaderStyle}" />
                                <TextBlock x:Uid="Settings_WindowKeysText" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel Spacing="12">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <FontIcon Glyph="&#xE72C;" FontSize="20" />
                                    <TextBlock x:Uid="Reset_Title" Style="{StaticResource CardHeaderStyle}" />
                                </StackPanel>
                                <TextBlock x:Uid="Reset_DataHeader" Style="{StaticResource GroupHeaderStyle}" />
                                <TextBlock x:Name="DataLocationText" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                                <TextBlock x:Name="DataSizesText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                <Button x:Uid="Reset_OpenFolder" Click="OnOpenDataFolderClick" />
                                <Grid ColumnSpacing="16" RowSpacing="16" Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <StackPanel>
                                        <TextBlock x:Uid="Reset_PlaybackTitle" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <TextBlock x:Uid="Reset_PlaybackText" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <Button Grid.Column="1" x:Uid="Reset_Button" Tag="playback" Click="OnResetClick" VerticalAlignment="Center" />
                                    <StackPanel Grid.Row="1">
                                        <TextBlock x:Uid="Reset_InterfaceTitle" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <TextBlock x:Uid="Reset_InterfaceText" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <Button Grid.Row="1" Grid.Column="1" x:Uid="Reset_Button" Tag="interface" Click="OnResetClick" VerticalAlignment="Center" />
                                    <StackPanel Grid.Row="2">
                                        <TextBlock x:Uid="Reset_LibraryTitle" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <TextBlock x:Uid="Reset_LibraryText" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <Button Grid.Row="2" Grid.Column="1" x:Uid="Reset_RebuildButton" Tag="library" Click="OnResetClick" VerticalAlignment="Center" />
                                    <StackPanel Grid.Row="3">
                                        <TextBlock x:Uid="Reset_CoversTitle" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <TextBlock x:Uid="Reset_CoversText" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <Button Grid.Row="3" Grid.Column="1" x:Uid="Reset_ClearButton" Tag="covers" Click="OnResetClick" VerticalAlignment="Center" />
                                    <StackPanel Grid.Row="4">
                                        <TextBlock x:Uid="Reset_AllTitle" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <TextBlock x:Uid="Reset_AllText" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <Button Grid.Row="4" Grid.Column="1" x:Uid="Reset_AllButton" Tag="all" Click="OnResetClick" VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Quick playlist actions (docs/Plan.md §8.3): name, count, a link and Undo while it is shown. -->
                <InfoBar x:Name="PlaylistNotice" IsOpen="False" IsClosable="True" VerticalAlignment="Bottom"
                         HorizontalAlignment="Right" MaxWidth="560" />
            </Grid>
                <Grid x:Name="QueuePanel" Grid.Column="1" Visibility="Collapsed" Padding="16,16,8,16"
                      Background="{ThemeResource LayerFillColorDefaultBrush}"
                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1,0,0,0" RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid ColumnSpacing="8" Padding="0,0,8,0">
                        <Grid.Resources>
                            <SolidColorBrush x:Key="ButtonBackground" Color="Transparent" />
                            <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
                            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
                            <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
                        </Grid.Resources>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Uid="Queue_Title" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <TextBlock x:Name="QueueCountText" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <Button Grid.Column="1" x:Uid="Queue_ClosePanel" Click="OnQueueToggleClick" Width="36" Height="36"
                                Padding="0" CornerRadius="18" VerticalAlignment="Top">
                            <FontIcon Glyph="&#xE711;" FontSize="14" />
                        </Button>
                    </Grid>
                    <ListView x:Name="QueueList" Grid.Row="1" SelectionMode="Extended" CanDragItems="True" CanReorderItems="True" AllowDrop="True"
                              DragItemsCompleted="OnQueueDragItemsCompleted" DoubleTapped="OnQueueDoubleTapped"
                              KeyDown="OnQueueKeyDown">
                        <ListView.Resources>
                            <SolidColorBrush x:Key="ButtonBackground" Color="Transparent" />
                            <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
                            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
                            <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
                        </ListView.Resources>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:QueueItem">
                                <Grid ColumnSpacing="8" AutomationProperties.Name="{x:Bind Title, Mode=OneWay}" Background="Transparent"
                                      ContextRequested="OnQueueContextRequested">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE767;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                              Visibility="{x:Bind IsCurrent, Mode=OneWay}" />
                                    <FontIcon x:Uid="Queue_AutomaticIcon" Glyph="&#xE8B1;" FontSize="12"
                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                              Visibility="{x:Bind ShowsAutomatic, Mode=OneWay}" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Title, Mode=OneWay}" TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" ToolTipService.ToolTip="{x:Bind Path, Mode=OneWay}"
                                               Visibility="{x:Bind IsNotCurrent, Mode=OneWay}" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Title, Mode=OneWay}" TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" ToolTipService.ToolTip="{x:Bind Path, Mode=OneWay}"
                                               FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                               Visibility="{x:Bind IsCurrent, Mode=OneWay}" />
                                    <FontIcon Grid.Column="2" Glyph="&#xE00B;" FontSize="12" Visibility="{x:Bind IsFavorite, Mode=OneWay}"
                                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    <Button Grid.Column="3" Width="32" Height="32" Padding="0" CornerRadius="16"
                                            Click="OnQueueRemoveEntryClick" ToolTipService.ToolTip="{x:Bind RemoveLabel}"
                                            AutomationProperties.Name="{x:Bind RemoveLabel}">
                                        <FontIcon Glyph="&#xE711;" FontSize="12" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock x:Name="QueueEmptyText" x:Uid="Queue_Empty" Grid.Row="1" TextWrapping="Wrap" Margin="0,0,8,0"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed" />
                    <StackPanel Grid.Row="2" Spacing="8" Padding="0,0,8,0">
                        <ToggleSwitch x:Name="QueueAutoplaySwitch" x:Uid="Queue_Autoplay" Toggled="OnAutoplayToggled" />
                        <Button x:Uid="Queue_Clear" Click="OnQueueClearClick" HorizontalAlignment="Stretch" />
                        <Button x:Uid="Queue_Save" Click="OnQueueSaveClick" HorizontalAlignment="Stretch" />
                    </StackPanel>
                </Grid>
            </Grid>
        </NavigationView>

        <!-- Full-width playback bar (docs/Plan.md §8.1) -->
        <Grid Grid.Row="1" Padding="24,8,24,12" RowSpacing="4" Background="{ThemeResource LayerFillColorDefaultBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <Grid.Resources>
                <Style x:Key="BadgeStyle" TargetType="Border">
                    <Setter Property="Padding" Value="8,2" />
                    <Setter Property="CornerRadius" Value="10" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                    <Setter Property="Background" Value="{ThemeResource ControlFillColorSecondaryBrush}" />
                    <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
                    <Setter Property="BorderThickness" Value="1" />
                </Style>
            </Grid.Resources>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <InfoBar x:Name="ErrorBar" Severity="Warning" IsOpen="False" IsClosable="True" />
            <Grid Grid.Row="1" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Slider x:Name="PositionSlider" Minimum="0" Maximum="1" StepFrequency="0.1" IsThumbToolTipEnabled="False"
                        VerticalAlignment="Center" ValueChanged="OnSliderValueChanged" />
                <TextBlock x:Name="TimeText" Grid.Column="1" VerticalAlignment="Center" MinWidth="100" TextAlignment="Right" Text="0:00 / 0:00"
                           Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>
            <Grid Grid.Row="2" ColumnSpacing="8" VerticalAlignment="Center">
                <Grid.Resources>
                    <SolidColorBrush x:Key="ButtonBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
                    <SolidColorBrush x:Key="ToggleButtonBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="ToggleButtonBorderBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="ToggleButtonBorderBrushPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="ToggleButtonBorderBrushPressed" Color="Transparent" />
                    <Style x:Key="TransportButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                        <Setter Property="Width" Value="40" />
                        <Setter Property="Height" Value="40" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="CornerRadius" Value="20" />
                    </Style>
                    <Style x:Key="TransportToggleStyle" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
                        <Setter Property="Width" Value="40" />
                        <Setter Property="Height" Value="40" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="CornerRadius" Value="20" />
                    </Style>
                </Grid.Resources>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0" ColumnSpacing="8" MinWidth="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="68" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="CoverButton" Click="OnCoverClick" Padding="0"
                            Background="Transparent" BorderThickness="0" VerticalAlignment="Center">
                        <Grid Width="60" Height="60">
                            <FontIcon Glyph="&#xE93C;" FontSize="28" Opacity="0.4" />
                            <Image x:Name="PlaybackCover" Width="60" Height="60" Stretch="Uniform" />
                        </Grid>
                    </Button>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1" HorizontalAlignment="Stretch">
                        <TextBlock x:Name="TitleText" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                   MaxLines="1" FontSize="13" FontWeight="SemiBold" />
                        <HyperlinkButton x:Name="ArtistLink" Click="OnArtistLinkClick" Padding="0"
                                         HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Visibility="Collapsed">
                            <TextBlock x:Name="ArtistLinkText" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" MaxLines="1" />
                        </HyperlinkButton>
                        <HyperlinkButton x:Name="AlbumLink" Click="OnAlbumLinkClick" Padding="0"
                                         HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Visibility="Collapsed">
                            <TextBlock x:Name="AlbumLinkText" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" MaxLines="1" />
                        </HyperlinkButton>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="16,0,0,0">
                        <ToggleButton x:Name="ShuffleButton" Click="OnShuffleClick" Style="{StaticResource TransportToggleStyle}">
                            <SymbolIcon Symbol="Shuffle" />
                        </ToggleButton>
                        <Button x:Name="StopButton" Click="OnStopClick" Style="{StaticResource TransportButtonStyle}">
                            <SymbolIcon Symbol="Stop" />
                        </Button>
                        <Button x:Name="PreviousButton" Click="OnPreviousClick" Style="{StaticResource TransportButtonStyle}">
                            <SymbolIcon Symbol="Previous" />
                        </Button>
                    </StackPanel>
                </Grid>
                <Button x:Name="PlayPauseButton" Grid.Column="1" Click="OnPlayPauseClick" Style="{StaticResource AccentButtonStyle}"
                        Width="48" Height="48" Padding="0" CornerRadius="24" VerticalAlignment="Center">
                    <SymbolIcon x:Name="PlayPauseIcon" Symbol="Play" />
                </Button>
                <Grid Grid.Column="2" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button x:Name="NextButton" Click="OnNextClick" Style="{StaticResource TransportButtonStyle}">
                            <SymbolIcon Symbol="Next" />
                        </Button>
                        <Button x:Name="RepeatButton" Click="OnRepeatClick" Style="{StaticResource TransportButtonStyle}">
                            <SymbolIcon x:Name="RepeatIcon" Symbol="RepeatAll" />
                        </Button>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <Button x:Name="PlaybackFavoriteButton" x:Uid="Marks_FavoriteButton" Click="OnPlaybackFavoriteClick" IsEnabled="False"
                                Width="48" Height="48" Padding="0" CornerRadius="24" VerticalAlignment="Center">
                            <FontIcon x:Name="PlaybackFavoriteIcon" Glyph="&#xE006;" FontSize="20" />
                        </Button>
                        <ToggleButton x:Name="QueueToggleButton" Click="OnQueueToggleClick"
                                      Style="{StaticResource TransportToggleStyle}" VerticalAlignment="Center">
                            <SymbolIcon Symbol="Bullets" />
                        </ToggleButton>
                    </StackPanel>
                </Grid>
            </Grid>
            <!-- Playback state, bit-perfect indicator and source badges (docs/Plan.md §5.2, §8.1) -->
            <Grid Grid.Row="3" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Border x:Name="StateBadge" Style="{StaticResource BadgeStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon x:Name="StateIcon" Glyph="&#xE71A;" FontSize="10" VerticalAlignment="Center" />
                            <TextBlock x:Name="StateText" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center"
                                       AutomationProperties.LiveSetting="Polite" />
                        </StackPanel>
                    </Border>
                    <Border x:Name="LampBadge" Style="{StaticResource BadgeStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse x:Name="Lamp" Width="8" Height="8" VerticalAlignment="Center"
                                     Fill="{ThemeResource ControlStrongFillColorDisabledBrush}" />
                            <TextBlock x:Name="LampText" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold"
                                       VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
                        </StackPanel>
                    </Border>
                    <Border x:Name="SourceBadge" Style="{StaticResource BadgeStyle}" Visibility="Collapsed">
                        <TextBlock x:Uid="Badge_Lossy" Style="{StaticResource CaptionTextBlockStyle}" />
                    </Border>
                    <Border x:Name="BypassBadge" Style="{StaticResource BadgeStyle}" Visibility="Collapsed">
                        <TextBlock x:Name="BypassText" Style="{StaticResource CaptionTextBlockStyle}" />
                    </Border>
                </StackPanel>
                <HyperlinkButton x:Name="FormatButton" x:Uid="SignalPath_Toggle" Grid.Column="1" Click="OnFormatClick"
                                 Padding="4,2" HorizontalAlignment="Left" MinWidth="0">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock x:Name="FormatText" Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                        <FontIcon x:Name="FormatChevron" Glyph="&#xE70D;" FontSize="10" VerticalAlignment="Center" />
                    </StackPanel>
                </HyperlinkButton>
            </Grid>
            <StackPanel x:Name="SignalPathPanel" Grid.Row="4" Spacing="2" Padding="4,2,0,0" Visibility="Collapsed">
                <TextBlock x:Name="SourceText" Style="{StaticResource CaptionTextBlockStyle}" IsTextSelectionEnabled="True"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="SignalPathText" Style="{StaticResource CaptionTextBlockStyle}" IsTextSelectionEnabled="True"
                           TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="SignalNoteText" Style="{StaticResource CaptionTextBlockStyle}" IsTextSelectionEnabled="True"
                           TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
