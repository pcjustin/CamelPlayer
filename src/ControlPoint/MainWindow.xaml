                                        <TextBlock x:Uid="Reset_InterfaceText" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <Button Grid.Row="1" Grid.Column="1" x:Uid="Reset_Button" HorizontalAlignment="Stretch" Tag="interface" Click="OnResetClick" VerticalAlignment="Center" />
                                    <StackPanel Grid.Row="2">
                                        <TextBlock x:Uid="Reset_LibraryTitle" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <TextBlock x:Uid="Reset_LibraryText" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <Button Grid.Row="2" Grid.Column="1" x:Uid="Reset_RebuildButton" HorizontalAlignment="Stretch" Tag="library" Click="OnResetClick" VerticalAlignment="Center" />
                                    <StackPanel Grid.Row="3">
                                        <TextBlock x:Uid="Reset_CoversTitle" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <TextBlock x:Uid="Reset_CoversText" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <Button Grid.Row="3" Grid.Column="1" x:Uid="Reset_ClearButton" HorizontalAlignment="Stretch" Tag="covers" Click="OnResetClick" VerticalAlignment="Center" />
                                    <StackPanel Grid.Row="4">
                                        <TextBlock x:Uid="Reset_StatisticsTitle" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <TextBlock x:Uid="Reset_StatisticsText" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
