<!-- Main window: navigation shell, settings and full-width playback bar. -->
<Window
    x:Class="CamelPlayer.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CamelPlayer"
    Title="CamelPlayer">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid KeyboardAcceleratorPlacementMode="Hidden" PreviewKeyDown="OnWindowKeyDown">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="OnSearchAccelerator" />
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Where Mica is not available (Windows 10) its fallback keeps the Windows colours; this follows the app's theme. -->
        <Border x:Name="ThemeBackground" Grid.RowSpan="4" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                Visibility="Collapsed" />

        <!-- The window's own title bar, in the app's theme: the pane toggle, and search on every page (docs/Plan.md §8.2):
             grouped suggestions while typing, Enter opens all results. -->
        <TitleBar x:Name="AppTitleBar" Title="CamelPlayer" IsPaneToggleButtonVisible="True" IsTabStop="False"
                  SizeChanged="OnTitleBarSizeChanged"
                  PaneToggleRequested="OnPaneToggleRequested" BackRequested="OnTitleBackRequested">
            <TitleBar.Content>
                <AutoSuggestBox x:Name="SearchBox" x:Uid="Search_Box" QueryIcon="Find" UpdateTextOnSelect="False"
                                Width="420" VerticalAlignment="Center"
                                TextChanged="OnSearchTextChanged" QuerySubmitted="OnSearchQuerySubmitted">
                    <AutoSuggestBox.ItemTemplate>
                        <DataTemplate x:DataType="local:BrowseItem">
                            <Grid ColumnSpacing="12" Padding="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{x:Bind Title, Mode=OneWay}" TextTrimming="CharacterEllipsis" IsTextTrimmedChanged="OnTextTrimmedChanged" TextWrapping="NoWrap" />
                                    <TextBlock Text="{x:Bind Subtitle, Mode=OneWay}" TextTrimming="CharacterEllipsis" IsTextTrimmedChanged="OnTextTrimmedChanged" TextWrapping="NoWrap"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{x:Bind Trailing, Mode=OneWay}" VerticalAlignment="Center"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>
                        </DataTemplate>
                    </AutoSuggestBox.ItemTemplate>
                </AutoSuggestBox>
            </TitleBar.Content>
        </TitleBar>

        <StackPanel Grid.Row="1">
            <!-- What opening the data at startup had to repair (a damaged settings file or library database). -->
            <InfoBar x:Name="RecoveryBar" Severity="Warning" IsOpen="False" IsClosable="True" />
            <!-- The installation check (docs/Plan.md §8.6): damaged or missing program files, repaired only after Repair. -->
            <InfoBar x:Name="RepairBar" Severity="Warning" IsOpen="False" IsClosable="False">
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
                    <Button x:Name="RepairButton" Style="{StaticResource AccentButtonStyle}" Click="OnRepairClick" />
                    <Button x:Name="RepairDetailsButton" x:Uid="Repair_Details" Click="OnRepairDetailsClick" />
                    <Button x:Name="RepairSkipButton" x:Uid="Repair_Skip" Click="OnRepairSkipClick" />
                    <ProgressBar x:Name="RepairProgress" Width="240" VerticalAlignment="Center" Visibility="Collapsed" />
                    <Button x:Name="RepairCancelButton" x:Uid="Update_Cancel" Click="OnRepairCancelClick" Visibility="Collapsed" />
                </StackPanel>
            </InfoBar>
            <!-- Automatic updates (docs/Plan.md §8.6): offered here, downloaded and installed only after Update. -->
            <InfoBar x:Name="UpdateBar" Severity="Informational" IsOpen="False" IsClosable="True">
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
                    <Button x:Name="UpdateInstallButton" Style="{StaticResource AccentButtonStyle}" Click="OnUpdateInstallClick" />
                    <Button x:Name="UpdateNotesButton" x:Uid="Update_Notes" Click="OnUpdateNotesClick" />
                    <Button x:Name="UpdateSkipButton" x:Uid="Update_Skip" Click="OnUpdateSkipClick" />
                    <ProgressBar x:Name="UpdateProgress" Width="240" VerticalAlignment="Center" Visibility="Collapsed" />
                    <Button x:Name="UpdateCancelButton" x:Uid="Update_Cancel" Click="OnUpdateCancelClick" Visibility="Collapsed" />
                </StackPanel>
            </InfoBar>
        </StackPanel>

        <NavigationView x:Name="Nav" Grid.Row="2" PaneDisplayMode="Left" OpenPaneLength="200" IsBackButtonVisible="Collapsed"
                        IsPaneToggleButtonVisible="False"
                        IsSettingsVisible="True" SelectionChanged="OnNavSelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Uid="Nav_Home" Tag="home" Icon="Home" />
                <NavigationViewItem x:Uid="Nav_Albums" Tag="albums" Icon="Library" />
                <NavigationViewItem x:Uid="Nav_Artists" Tag="artists" Icon="People" />
                <NavigationViewItem x:Uid="Nav_Composers" Tag="composers" Icon="Edit" />
                <NavigationViewItem x:Uid="Nav_Genres" Tag="genres" Icon="Tag" />
                <NavigationViewItem x:Uid="Nav_Years" Tag="years" Icon="Calendar" />
                <NavigationViewItem x:Uid="Nav_Tracks" Tag="tracks" Icon="List" />
                <NavigationViewItem x:Uid="Nav_Folders" Tag="folders" Icon="Folder" />
                <NavigationViewItemSeparator />
                <NavigationViewItem x:Name="PlaylistsNav" x:Uid="Nav_Playlists" Tag="playlists" Icon="MusicInfo" />
                <NavigationViewItem x:Uid="Nav_SmartPlaylists" Tag="smart" Icon="Favorite" SelectsOnInvoked="False">
                    <NavigationViewItem.MenuItems>
                        <NavigationViewItem x:Uid="Nav_SmartAdded" Tag="smart:added">
                            <NavigationViewItem.Icon><FontIcon Glyph="&#xE710;" /></NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem x:Uid="Nav_SmartMostPlayed" Tag="smart:mostPlayed">
                            <NavigationViewItem.Icon><FontIcon Glyph="&#xE8D6;" /></NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem x:Uid="Nav_SmartRecentlyPlayed" Tag="smart:recentlyPlayed">
                            <NavigationViewItem.Icon><FontIcon Glyph="&#xE81C;" /></NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem x:Uid="Nav_SmartFavorites" Tag="smart:favorites">
                            <NavigationViewItem.Icon><FontIcon Glyph="&#xE00B;" /></NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem x:Uid="Nav_SmartFavoriteAlbums" Tag="smart:favoriteAlbums">
                            <NavigationViewItem.Icon><FontIcon Glyph="&#xE93C;" /></NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem x:Uid="Nav_SmartFavoriteArtists" Tag="smart:favoriteArtists">
                            <NavigationViewItem.Icon><FontIcon Glyph="&#xE77B;" /></NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem x:Uid="Nav_SmartNeverPlayed" Tag="smart:neverPlayed">
                            <NavigationViewItem.Icon><FontIcon Glyph="&#xE7C1;" /></NavigationViewItem.Icon>
                        </NavigationViewItem>
                    </NavigationViewItem.MenuItems>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Grid x:Name="ContentLayout" ColumnSpacing="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="QueueColumn" Width="0" />
                </Grid.ColumnDefinitions>
            <Grid Padding="32,24,32,16">

                <local:HomeView x:Name="Home" Visibility="Collapsed" />
                <local:LibraryView x:Name="Library" Visibility="Collapsed" />
                <local:PlaylistView x:Name="Playlists" Visibility="Collapsed" />

                <!-- Pages of later versions (smart playlists) -->
                <StackPanel x:Name="PlaceholderPanel" Spacing="8" Visibility="Collapsed">
                    <TextBlock x:Name="PlaceholderTitle" Style="{StaticResource TitleTextBlockStyle}" AutomationProperties.HeadingLevel="Level1" />
                    <TextBlock x:Uid="Placeholder_Text" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>

                <!-- Settings (docs/Plan.md §6, §8.2): one card per area; rarely changed timing values sit in expanders. -->
                <!-- The title and the links to each card stay in place while the cards scroll. -->
                <Grid x:Name="SettingsPanel" Visibility="Collapsed" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel MaxWidth="820" HorizontalAlignment="Left">
                    <TextBlock x:Uid="Settings_Title" Style="{StaticResource TitleTextBlockStyle}" AutomationProperties.HeadingLevel="Level1" />
                    <!-- Filled in from the card titles; one Tab stop, the arrow keys move along. -->
                    <ScrollViewer HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Hidden" VerticalScrollMode="Disabled"
                                  VerticalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="SettingsLinks" Orientation="Horizontal" Spacing="20"
                                    TabFocusNavigation="Once" XYFocusKeyboardNavigation="Enabled" />
                    </ScrollViewer>
                </StackPanel>
                <ScrollViewer x:Name="SettingsScroller" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              ViewChanged="OnSettingsScrolled">
                    <StackPanel Spacing="16" MaxWidth="820" HorizontalAlignment="Left" Padding="0,0,16,24">
                        <StackPanel.Resources>
                            <Style x:Key="SettingsCardStyle" TargetType="Border">
                                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                                <Setter Property="BorderThickness" Value="1" />
                                <Setter Property="CornerRadius" Value="8" />
                                <Setter Property="Padding" Value="20,16" />
                            </Style>
                            <Style x:Key="CardHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource SubtitleTextBlockStyle}">
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Setter Property="AutomationProperties.HeadingLevel" Value="Level2" />
                            </Style>
                            <Style x:Key="GroupHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                                <Setter Property="Margin" Value="0,4,0,0" />
                                <Setter Property="AutomationProperties.HeadingLevel" Value="Level3" />
                            </Style>
                            <Style x:Key="StatusLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
                                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Style>
                            <Style x:Key="StatusValueStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
                                <Setter Property="IsTextSelectionEnabled" Value="True" />
                                <Setter Property="TextWrapping" Value="Wrap" />
                            </Style>
                        </StackPanel.Resources>
                        <Border x:Name="LibraryCard" Style="{StaticResource SettingsCardStyle}">
                            <StackPanel Spacing="12">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <FontIcon Glyph="&#xE8F1;" FontSize="20" />
                                    <TextBlock x:Uid="Settings_Library" Style="{StaticResource CardHeaderStyle}" />
                                </StackPanel>
                                <ListView x:Name="RootList" SelectionMode="Single" MaxHeight="240" CornerRadius="4"
                                          BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" />
                                <TextBlock x:Name="ScanText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                                           Visibility="Collapsed" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button x:Uid="Settings_AddFolder" Click="OnAddFolderClick" Style="{StaticResource AccentButtonStyle}" />
                                    <Button x:Uid="Settings_RemoveFolder" Click="OnRemoveFolderClick" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border x:Name="OutputsCard" Style="{StaticResource SettingsCardStyle}">
                            <StackPanel Spacing="12">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <FontIcon Glyph="&#xE7F5;" FontSize="20" />
                                    <TextBlock x:Uid="Settings_Outputs" Style="{StaticResource CardHeaderStyle}" />
                                </StackPanel>
                                <TextBlock x:Uid="Settings_OutputsNote" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <InfoBar x:Name="FirewallNotice" x:Uid="Firewall_Notice" Severity="Warning" IsOpen="False" IsClosable="False">
                                    <InfoBar.ActionButton>
                                        <Button x:Uid="Firewall_AddButton" Click="OnAddFirewallRuleClick" />
                                    </InfoBar.ActionButton>
                                </InfoBar>
                                <StackPanel x:Name="OutputList" Spacing="4" />
                                <Button x:Uid="Settings_Refresh" Click="OnRefreshDevicesClick" />

                                <StackPanel x:Name="WasapiGroup" Spacing="12">
                                    <TextBlock Text="WASAPI" Style="{StaticResource GroupHeaderStyle}" />
                                    <ComboBox x:Name="WasapiShareCombo" x:Uid="Settings_WasapiShare" Width="360" SelectionChanged="OnSettingChanged" />
                                    <ComboBox x:Name="WasapiSharedQualityCombo" x:Uid="Settings_WasapiSharedQuality" Width="360" SelectionChanged="OnSettingChanged" />
                                    <ComboBox x:Name="WasapiModeCombo" x:Uid="Settings_WasapiMode" Width="360" SelectionChanged="OnSettingChanged" />
                                    <ComboBox x:Name="WasapiFormatCombo" x:Uid="Settings_SampleFormat" Width="360" SelectionChanged="OnSettingChanged" />
                                    <ComboBox x:Name="WasapiRateCombo" x:Uid="Settings_FixedRate" Width="360" SelectionChanged="OnSettingChanged" />
                                    <ComboBox x:Name="WasapiDsdCombo" x:Uid="Settings_DsdOutput" Width="360" SelectionChanged="OnSettingChanged" />
                                    <ComboBox x:Name="WasapiDsdRateCombo" x:Uid="Settings_DsdPcmRate" Width="360" SelectionChanged="OnSettingChanged" />
                                    <Expander x:Uid="Settings_Advanced" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                                        <StackPanel Spacing="12">
                                            <ComboBox x:Name="WasapiPeriodCombo" x:Uid="Settings_Period" Width="360" SelectionChanged="OnSettingChanged" />
                                            <NumberBox x:Name="WasapiPeriodBox" x:Uid="Settings_PeriodMs" Width="200" HorizontalAlignment="Left" Minimum="1" Maximum="500"
                                                       SpinButtonPlacementMode="Compact" ValueChanged="OnNumberChanged" />
                                            <NumberBox x:Name="WasapiPollBufferBox" x:Uid="Settings_PollBuffer" Width="200" HorizontalAlignment="Left" Minimum="20" Maximum="2000"
                                                       SpinButtonPlacementMode="Compact" ValueChanged="OnNumberChanged" />
                                            <ComboBox x:Name="WasapiMmcssTaskCombo" x:Uid="Settings_MmcssTask" Width="360" SelectionChanged="OnSettingChanged" />
                                            <ComboBox x:Name="WasapiMmcssPriorityCombo" x:Uid="Settings_MmcssPriority" Width="360" SelectionChanged="OnSettingChanged" />
                                            <NumberBox x:Name="WasapiPredecodeBox" x:Uid="Settings_Predecode" Width="320" HorizontalAlignment="Left" Minimum="1" Maximum="60"
                                                       SpinButtonPlacementMode="Compact" ValueChanged="OnNumberChanged" />
                                            <NumberBox x:Name="WasapiSilenceBox" x:Uid="Settings_FormatSilence" Width="320" HorizontalAlignment="Left" Minimum="0" Maximum="2000"
                                                       SpinButtonPlacementMode="Compact" ValueChanged="OnNumberChanged" />
                                            <NumberBox x:Name="WasapiReleaseBox" x:Uid="Settings_ReleaseAfterPause" Width="320" HorizontalAlignment="Left" Minimum="0" Maximum="3600"
                                                       SpinButtonPlacementMode="Compact" ValueChanged="OnNumberChanged" />
                                        </StackPanel>
                                    </Expander>
                                </StackPanel>

                                <StackPanel x:Name="AsioGroup" Spacing="12">
                                    <TextBlock Text="ASIO" Style="{StaticResource GroupHeaderStyle}" />
                                    <Button x:Uid="Settings_AsioPanel" Click="OnAsioPanelClick" />
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <NumberBox x:Name="AsioLeftBox" x:Uid="Settings_AsioLeft" Width="160" Minimum="1" Maximum="64"
                                                   SpinButtonPlacementMode="Compact" ValueChanged="OnNumberChanged" />
                                        <NumberBox x:Name="AsioRightBox" x:Uid="Settings_AsioRight" Width="160" Minimum="1" Maximum="64"
                                                   SpinButtonPlacementMode="Compact" ValueChanged="OnNumberChanged" />
                                    </StackPanel>
                                    <ComboBox x:Name="AsioRateCombo" x:Uid="Settings_FixedRate" Width="360" SelectionChanged="OnSettingChanged" />
                                    <ComboBox x:Name="AsioDsdCombo" x:Uid="Settings_DsdOutput" Width="360" SelectionChanged="OnSettingChanged" />
                                    <ComboBox x:Name="AsioDsdRateCombo" x:Uid="Settings_DsdPcmRate" Width="360" SelectionChanged="OnSettingChanged" />
                                    <Expander x:Uid="Settings_Advanced" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                                        <StackPanel Spacing="12">
                                            <NumberBox x:Name="AsioBufferBox" x:Uid="Settings_AsioBuffer" Width="200" HorizontalAlignment="Left" Minimum="0" Maximum="65536"
                                                       SpinButtonPlacementMode="Compact" ValueChanged="OnNumberChanged" />
                                            <NumberBox x:Name="AsioPredecodeBox" x:Uid="Settings_Predecode" Width="320" HorizontalAlignment="Left" Minimum="1" Maximum="60"
                                                       SpinButtonPlacementMode="Compact" ValueChanged="OnNumberChanged" />
                                            <NumberBox x:Name="AsioSilenceBox" x:Uid="Settings_FormatSilence" Width="320" HorizontalAlignment="Left" Minimum="0" Maximum="2000"
                                                       SpinButtonPlacementMode="Compact" ValueChanged="OnNumberChanged" />
                                            <NumberBox x:Name="AsioReleaseBox" x:Uid="Settings_ReleaseAfterPause" Width="320" HorizontalAlignment="Left" Minimum="0" Maximum="3600"
                                                       SpinButtonPlacementMode="Compact" ValueChanged="OnNumberChanged" />
                                        </StackPanel>
                                    </Expander>
                                </StackPanel>

                                <StackPanel x:Name="KsGroup" Spacing="12">
                                    <TextBlock Text="Kernel Streaming" Style="{StaticResource GroupHeaderStyle}" />
                                    <ComboBox x:Name="KsModeCombo" x:Uid="Settings_KsMode" Width="360" SelectionChanged="OnSettingChanged" />
                                    <ComboBox x:Name="KsFormatCombo" x:Uid="Settings_SampleFormat" Width="360" SelectionChanged="OnSettingChanged" />
                                    <ComboBox x:Name="KsRateCombo" x:Uid="Settings_FixedRate" Width="360" SelectionChanged="OnSettingChanged" />
                                    <ComboBox x:Name="KsDsdCombo" x:Uid="Settings_DsdOutput" Width="360" SelectionChanged="OnSettingChanged" />
                                    <ComboBox x:Name="KsDsdRateCombo" x:Uid="Settings_DsdPcmRate" Width="360" SelectionChanged="OnSettingChanged" />
                                    <Expander x:Uid="Settings_Advanced" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                                        <StackPanel Spacing="12">
                                            <NumberBox x:Name="KsBufferBox" x:Uid="Settings_KsBuffer" Width="200" HorizontalAlignment="Left" Minimum="2" Maximum="1000"
                                                       SpinButtonPlacementMode="Compact" ValueChanged="OnNumberChanged" />
                                            <StackPanel Orientation="Horizontal" Spacing="12">
                                                <NumberBox x:Name="KsPacketCountBox" x:Uid="Settings_KsPacketCount" Width="160" Minimum="2" Maximum="16"
                                                           SpinButtonPlacementMode="Compact" ValueChanged="OnNumberChanged" />
                                                <NumberBox x:Name="KsPacketMsBox" x:Uid="Settings_KsPacketMs" Width="160" Minimum="1" Maximum="200"
                                                           SpinButtonPlacementMode="Compact" ValueChanged="OnNumberChanged" />
                                            </StackPanel>
                                            <ComboBox x:Name="KsMmcssTaskCombo" x:Uid="Settings_MmcssTask" Width="360" SelectionChanged="OnSettingChanged" />
                                            <ComboBox x:Name="KsMmcssPriorityCombo" x:Uid="Settings_MmcssPriority" Width="360" SelectionChanged="OnSettingChanged" />
                                            <NumberBox x:Name="KsPredecodeBox" x:Uid="Settings_Predecode" Width="320" HorizontalAlignment="Left" Minimum="1" Maximum="60"
                                                       SpinButtonPlacementMode="Compact" ValueChanged="OnNumberChanged" />
                                            <NumberBox x:Name="KsSilenceBox" x:Uid="Settings_FormatSilence" Width="320" HorizontalAlignment="Left" Minimum="0" Maximum="2000"
                                                       SpinButtonPlacementMode="Compact" ValueChanged="OnNumberChanged" />
                                            <NumberBox x:Name="KsReleaseBox" x:Uid="Settings_ReleaseAfterPause" Width="320" HorizontalAlignment="Left" Minimum="0" Maximum="3600"
                                                       SpinButtonPlacementMode="Compact" ValueChanged="OnNumberChanged" />
                                        </StackPanel>
                                    </Expander>
                                    <TextBlock x:Uid="Settings_KsNote" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>

                                <StackPanel x:Name="NetworkGroup" Spacing="12">
                                    <TextBlock x:Uid="Settings_NetworkGroup" Style="{StaticResource GroupHeaderStyle}" />
                                    <ComboBox x:Name="NetworkRateCombo" x:Uid="Settings_NetworkRate" Width="360" SelectionChanged="OnSettingChanged" />
                                    <ComboBox x:Name="NetworkBitsCombo" x:Uid="Settings_NetworkBits" Width="360" SelectionChanged="OnSettingChanged" />
                                    <ComboBox x:Name="NetworkDsdCombo" x:Uid="Settings_DsdOutput" Width="360" SelectionChanged="OnSettingChanged" />
                                    <ComboBox x:Name="NetworkDsdRateCombo" x:Uid="Settings_DsdPcmRate" Width="360" SelectionChanged="OnSettingChanged" />
                                    <ToggleSwitch x:Name="NetworkGaplessSwitch" x:Uid="Settings_NetworkGapless" Toggled="OnNetworkGaplessToggled" />
                                    <TextBlock x:Uid="Settings_NetworkGaplessNote" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <Expander x:Uid="Settings_Advanced" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                                        <StackPanel Spacing="12">
                                            <NumberBox x:Name="NetworkPredecodeBox" x:Uid="Settings_Predecode" Width="320" HorizontalAlignment="Left" Minimum="1" Maximum="60"
                                                       SpinButtonPlacementMode="Compact" ValueChanged="OnNumberChanged" />
                                            <NumberBox x:Name="NetworkSilenceBox" x:Uid="Settings_FormatSilence" Width="320" HorizontalAlignment="Left" Minimum="0" Maximum="2000"
                                                       SpinButtonPlacementMode="Compact" ValueChanged="OnNumberChanged" />
                                            <NumberBox x:Name="NetworkReleaseBox" x:Uid="Settings_ReleaseAfterPause" Width="320" HorizontalAlignment="Left" Minimum="0" Maximum="3600"
                                                       SpinButtonPlacementMode="Compact" ValueChanged="OnNumberChanged" />
                                        </StackPanel>
                                    </Expander>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border x:Name="PlaybackCard" Style="{StaticResource SettingsCardStyle}">
                            <StackPanel Spacing="12">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <FontIcon Glyph="&#xE768;" FontSize="20" />
                                    <TextBlock x:Uid="Settings_Playback" Style="{StaticResource CardHeaderStyle}" />
                                </StackPanel>
                                <TextBlock x:Uid="Settings_ApplyNote" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <ComboBox x:Name="ConvertCombo" x:Uid="Settings_Convert" Width="520" SelectionChanged="OnSettingChanged" />
                                <ComboBox x:Name="ResampleQualityCombo" x:Uid="Settings_ResampleQuality" Width="360" SelectionChanged="OnSettingChanged" />
                                <ComboBox x:Name="ConvertDsdCombo" x:Uid="Settings_ConvertDsd" Width="520" SelectionChanged="OnSettingChanged" />
                                <ToggleSwitch x:Name="AutoplaySwitch" x:Uid="Settings_Autoplay" Toggled="OnAutoplayToggled" />
                                <ToggleSwitch x:Name="FolderPlaysOnSwitch" x:Uid="Settings_FolderPlaysOn" Toggled="OnFolderPlaysOnToggled" />
                            </StackPanel>
                        </Border>

                        <!-- The DSP chain (docs/Plan.md §5.9), one global setting: EQ, crossfeed and convolution in the order set here,
                             after one automatic preamp. EqEditor draws the EQ curve and band rows; the order rows are built in code. -->
                        <!-- DSP settings in three cards: volume and ReplayGain, crossfade, and the processing chain. -->
                        <Border x:Name="VolumeCard" Style="{StaticResource SettingsCardStyle}">
                            <StackPanel Spacing="12">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <FontIcon Glyph="&#xE767;" FontSize="20" />
                                    <TextBlock x:Uid="Settings_VolumeCard" Style="{StaticResource CardHeaderStyle}" />
                                </StackPanel>

                                <TextBlock x:Uid="Settings_Volume" Style="{StaticResource GroupHeaderStyle}" />
                                <ComboBox x:Name="VolumeModeCombo" x:Uid="Settings_VolumeMode" Width="240" SelectionChanged="OnVolumeModeChanged">
                                    <ComboBoxItem x:Uid="Settings_VolumeFixed" />
                                    <ComboBoxItem x:Name="VolumeModeOwnItem" />
                                </ComboBox>
                                <TextBlock x:Name="VolumeNote" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                <TextBlock x:Uid="Settings_ReplayGain" Style="{StaticResource GroupHeaderStyle}" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <ComboBox x:Name="ReplayGainModeCombo" x:Uid="Settings_ReplayGainMode" Width="160"
                                              SelectionChanged="OnReplayGainChanged">
                                        <ComboBoxItem x:Uid="Settings_ReplayGainOff" />
                                        <ComboBoxItem x:Uid="Settings_ReplayGainTrack" />
                                        <ComboBoxItem x:Uid="Settings_ReplayGainAlbum" />
                                        <ComboBoxItem x:Uid="Settings_ReplayGainAuto" />
                                    </ComboBox>
                                    <NumberBox x:Name="ReplayGainPreampBox" x:Uid="Settings_ReplayGainPreamp" Width="170" Minimum="-15" Maximum="15"
                                               SmallChange="0.5" LargeChange="3" SpinButtonPlacementMode="Compact"
                                               ValueChanged="OnReplayGainValueChanged" />
                                    <NumberBox x:Name="ReplayGainNoValueBox" x:Uid="Settings_ReplayGainNoValue" Width="170" Minimum="-15" Maximum="15"
                                               SmallChange="0.5" LargeChange="3" SpinButtonPlacementMode="Compact"
                                               ValueChanged="OnReplayGainValueChanged" />
                                </StackPanel>
                                <ToggleSwitch x:Name="ReplayGainClipSwitch" x:Uid="Settings_ReplayGainClip" Toggled="OnReplayGainToggled" />
                                <ComboBox x:Name="LoudnessSpeedCombo" x:Uid="Settings_LoudnessSpeed" Width="240" SelectionChanged="OnReplayGainChanged">
                                    <ComboBoxItem x:Uid="Settings_LoudnessThrottled" />
                                    <ComboBoxItem x:Uid="Settings_LoudnessFast" />
                                </ComboBox>
