                                    <StackPanel Grid.Row="5">
                                        <TextBlock x:Uid="Reset_AllTitle" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <TextBlock x:Uid="Reset_AllText" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <Button Grid.Row="5" Grid.Column="1" x:Uid="Reset_AllButton" HorizontalAlignment="Stretch" Tag="all" Click="OnResetClick" VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border x:Name="AboutCard" Style="{StaticResource SettingsCardStyle}">
                            <StackPanel Spacing="12">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <FontIcon Glyph="&#xE946;" FontSize="20" />
                                    <TextBlock x:Uid="Settings_About" Style="{StaticResource CardHeaderStyle}" />
                                </StackPanel>
                                <StackPanel Spacing="4">
                                    <TextBlock x:Name="AboutVersionText" Style="{StaticResource BodyStrongTextBlockStyle}" IsTextSelectionEnabled="True" />
                                    <TextBlock x:Uid="Settings_AboutLicense" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Uid="Settings_AboutAirPlay" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Button x:Name="CheckUpdatesButton" x:Uid="Settings_CheckUpdates" Click="OnCheckUpdatesClick" />
                                    <TextBlock x:Name="UpdateStatusText" VerticalAlignment="Center" TextWrapping="Wrap"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Button x:Name="CheckInstallButton" x:Uid="Settings_CheckInstall" Click="OnCheckInstallClick" />
                                    <TextBlock x:Name="InstallStatusText" VerticalAlignment="Center" TextWrapping="Wrap"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <TextBlock x:Uid="Settings_Diagnostics" Style="{StaticResource GroupHeaderStyle}" />
                                <TextBlock x:Uid="Settings_DiagnosticsText" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <CheckBox x:Name="DiagnosticPathsCheck" x:Uid="Settings_DiagnosticPaths" />
                                <Button x:Name="DiagnosticButton" x:Uid="Settings_DiagnosticButton" Click="OnDiagnosticBundleClick" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
                </Grid>

                <!-- Quick playlist actions (docs/Plan.md §8.3): name, count, a link and Undo while it is shown. -->
                <InfoBar x:Name="PlaylistNotice" IsOpen="False" IsClosable="True" VerticalAlignment="Bottom"
                         HorizontalAlignment="Right" MaxWidth="560" />
            </Grid>
                <Grid x:Name="QueuePanel" Grid.Column="1" Visibility="Collapsed" Padding="16,16,8,16"
                      Background="{ThemeResource LayerFillColorDefaultBrush}"
                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1,0,0,0" RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid ColumnSpacing="4" Padding="0,0,8,0">
                        <Grid.Resources>
                            <SolidColorBrush x:Key="ButtonBackground" Color="Transparent" />
                            <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
                            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
                            <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
                        </Grid.Resources>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Uid="Queue_Title" Style="{StaticResource SubtitleTextBlockStyle}" AutomationProperties.HeadingLevel="Level2" />
                            <TextBlock x:Name="QueueCountText" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <Button Grid.Column="1" x:Uid="Queue_More" Width="36" Height="36" Padding="0" CornerRadius="18"
                                VerticalAlignment="Top">
                            <FontIcon Glyph="&#xE712;" FontSize="14" />
                            <Button.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedRight">
                                    <ToggleMenuFlyoutItem x:Name="QueueAutoplayItem" x:Uid="Queue_Autoplay"
                                                          Click="OnQueueAutoplayClick" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem x:Uid="Queue_Save" Click="OnQueueSaveClick">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74E;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem x:Uid="Queue_Clear" Click="OnQueueClearClick">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                        <Button Grid.Column="2" x:Uid="Queue_ClosePanel" Click="OnQueueToggleClick" Width="36" Height="36"
                                Padding="0" CornerRadius="18" VerticalAlignment="Top">
                            <FontIcon Glyph="&#xE711;" FontSize="14" />
                        </Button>
                    </Grid>
                    <ListView x:Name="QueueList" Grid.Row="1" SelectionMode="Extended" CanDragItems="True" CanReorderItems="True" AllowDrop="True"
                              DragItemsCompleted="OnQueueDragItemsCompleted" DoubleTapped="OnQueueDoubleTapped"
                              KeyDown="OnQueueKeyDown">
                        <ListView.Resources>
                            <SolidColorBrush x:Key="ButtonBackground" Color="Transparent" />
                            <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
                            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
                            <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
                        </ListView.Resources>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:QueueItem">
                                <Grid ColumnSpacing="8" AutomationProperties.Name="{x:Bind Title, Mode=OneWay}" Background="Transparent"
                                      ContextRequested="OnQueueContextRequested">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE767;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                              Visibility="{x:Bind IsCurrent, Mode=OneWay}" />
                                    <FontIcon x:Uid="Queue_AutomaticIcon" Glyph="&#xE8B1;" FontSize="12"
                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                              Visibility="{x:Bind ShowsAutomatic, Mode=OneWay}" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Padding="0,4"
                                                ToolTipService.ToolTip="{x:Bind Path, Mode=OneWay}">
                                        <TextBlock Text="{x:Bind Title, Mode=OneWay}" TextTrimming="CharacterEllipsis" IsTextTrimmedChanged="OnTextTrimmedChanged"
                                                   Visibility="{x:Bind IsNotCurrent, Mode=OneWay}" />
                                        <TextBlock Text="{x:Bind Title, Mode=OneWay}" TextTrimming="CharacterEllipsis" IsTextTrimmedChanged="OnTextTrimmedChanged"
                                                   FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                   Visibility="{x:Bind IsCurrent, Mode=OneWay}" />
                                        <TextBlock Text="{x:Bind Artist, Mode=OneWay}" TextTrimming="CharacterEllipsis" IsTextTrimmedChanged="OnTextTrimmedChanged"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   Visibility="{x:Bind HasArtist, Mode=OneWay}" />
                                    </StackPanel>
                                    <FontIcon Grid.Column="2" Glyph="&#xE00B;" FontSize="12" Visibility="{x:Bind IsFavorite, Mode=OneWay}"
                                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    <Button Grid.Column="3" Width="32" Height="32" Padding="0" CornerRadius="16"
                                            Click="OnQueueRemoveEntryClick" ToolTipService.ToolTip="{x:Bind RemoveLabel}"
                                            AutomationProperties.Name="{x:Bind RemoveLabel}">
                                        <FontIcon Glyph="&#xE711;" FontSize="12" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock x:Name="QueueEmptyText" x:Uid="Queue_Empty" Grid.Row="1" TextWrapping="Wrap" Margin="0,0,8,0"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed" />
                </Grid>
            </Grid>
        </NavigationView>

