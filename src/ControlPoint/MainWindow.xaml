<!-- Main window: navigation shell, settings and full-width playback bar. -->
<Window
    x:Class="CamelPlayer.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CamelPlayer"
    Title="CamelPlayer v2">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <NavigationView x:Name="Nav" PaneDisplayMode="Left" OpenPaneLength="200" IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="True" SelectionChanged="OnNavSelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Uid="Nav_Albums" Tag="albums" Icon="Library" />
                <NavigationViewItem x:Uid="Nav_Artists" Tag="artists" Icon="People" />
                <NavigationViewItem x:Uid="Nav_Composers" Tag="composers" Icon="Edit" />
                <NavigationViewItem x:Uid="Nav_Genres" Tag="genres" Icon="Tag" />
                <NavigationViewItem x:Uid="Nav_Years" Tag="years" Icon="Calendar" />
                <NavigationViewItem x:Uid="Nav_Tracks" Tag="tracks" Icon="List" />
                <NavigationViewItem x:Uid="Nav_Folders" Tag="folders" Icon="Folder" />
                <NavigationViewItemSeparator />
                <NavigationViewItem x:Uid="Nav_Playlists" Tag="playlists" Icon="MusicInfo" />
                <NavigationViewItem x:Uid="Nav_SmartPlaylists" Tag="smart" Icon="Favorite" />
            </NavigationView.MenuItems>

            <Grid x:Name="ContentLayout" ColumnSpacing="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="QueueColumn" Width="0" />
                </Grid.ColumnDefinitions>
            <Grid Padding="32,24,32,16">

                <local:LibraryView x:Name="Library" Visibility="Collapsed" />

                <!-- Playlist pages arrive in M5 -->
                <StackPanel x:Name="PlaceholderPanel" Spacing="8" Visibility="Collapsed">
                    <TextBlock x:Name="PlaceholderTitle" Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock x:Uid="Placeholder_Text" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>

                <!-- Settings (docs/Plan.md §16.4) -->
                <ScrollViewer x:Name="SettingsPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="12" MaxWidth="680" HorizontalAlignment="Left" Padding="0,0,16,24">
                        <TextBlock x:Uid="Settings_Title" Style="{StaticResource TitleTextBlockStyle}" />

                        <TextBlock x:Uid="Settings_Library" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,8,0,0" />
                        <ListView x:Name="RootList" SelectionMode="Single" MaxHeight="200" Width="520" HorizontalAlignment="Left"
                                  BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" />
                        <TextBlock x:Name="ScanText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                                   Visibility="Collapsed" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Uid="Settings_AddFolder" Click="OnAddFolderClick" />
                            <Button x:Uid="Settings_RemoveFolder" Click="OnRemoveFolderClick" />
                        </StackPanel>

                        <TextBlock x:Uid="Settings_Playback" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,8,0,0" />
                        <ComboBox x:Name="BackendCombo" x:Uid="Settings_Backend" Width="360" SelectionChanged="OnSettingChanged" />
                        <ComboBox x:Name="DecoderCombo" x:Uid="Settings_Decoder" Width="360" SelectionChanged="OnSettingChanged" />
                        <ComboBox x:Name="AlacDecoderCombo" x:Uid="Settings_AlacDecoder" Width="360" SelectionChanged="OnSettingChanged" />
                        <ComboBox x:Name="WavDecoderCombo" x:Uid="Settings_WavDecoder" Width="360" SelectionChanged="OnSettingChanged" />
                        <ComboBox x:Name="AiffDecoderCombo" x:Uid="Settings_AiffDecoder" Width="360" SelectionChanged="OnSettingChanged" />
                        <ComboBox x:Name="AacDecoderCombo" x:Uid="Settings_AacDecoder" Width="360" SelectionChanged="OnSettingChanged" />
                        <ComboBox x:Name="AacBitsCombo" x:Uid="Settings_AacBits" Width="360" SelectionChanged="OnSettingChanged" />
                        <ComboBox x:Name="Mp3DecoderCombo" x:Uid="Settings_Mp3Decoder" Width="360" SelectionChanged="OnSettingChanged" />
                        <ComboBox x:Name="Mp3BitsCombo" x:Uid="Settings_Mp3Bits" Width="360" SelectionChanged="OnSettingChanged" />
                        <ComboBox x:Name="ConvertCombo" x:Uid="Settings_Convert" Width="520" SelectionChanged="OnSettingChanged" />
                        <ComboBox x:Name="ResampleQualityCombo" x:Uid="Settings_ResampleQuality" Width="360" SelectionChanged="OnSettingChanged" />

                        <StackPanel x:Name="WasapiGroup" Spacing="12">
                            <TextBlock Text="WASAPI" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,8,0,0" />
                            <ComboBox x:Name="WasapiDeviceCombo" x:Uid="Settings_Device" Width="520" SelectionChanged="OnSettingChanged" />
                            <ComboBox x:Name="WasapiShareCombo" x:Uid="Settings_WasapiShare" Width="360" SelectionChanged="OnSettingChanged" />
                            <ComboBox x:Name="WasapiSharedQualityCombo" x:Uid="Settings_WasapiSharedQuality" Width="360" SelectionChanged="OnSettingChanged" />
                            <ComboBox x:Name="WasapiModeCombo" x:Uid="Settings_WasapiMode" Width="360" SelectionChanged="OnSettingChanged" />
                            <ComboBox x:Name="WasapiPeriodCombo" x:Uid="Settings_Period" Width="360" SelectionChanged="OnSettingChanged" />
                            <NumberBox x:Name="WasapiPeriodBox" x:Uid="Settings_PeriodMs" Width="200" HorizontalAlignment="Left" Minimum="1" Maximum="500"
                                       SpinButtonPlacementMode="Compact" ValueChanged="OnNumberChanged" />
                            <ComboBox x:Name="WasapiFormatCombo" x:Uid="Settings_SampleFormat" Width="360" SelectionChanged="OnSettingChanged" />
                            <ComboBox x:Name="WasapiRateCombo" x:Uid="Settings_FixedRate" Width="360" SelectionChanged="OnSettingChanged" />
                            <NumberBox x:Name="WasapiPollBufferBox" x:Uid="Settings_PollBuffer" Width="200" HorizontalAlignment="Left" Minimum="20" Maximum="2000"
                                       SpinButtonPlacementMode="Compact" ValueChanged="OnNumberChanged" />
                            <ComboBox x:Name="WasapiMmcssTaskCombo" x:Uid="Settings_MmcssTask" Width="360" SelectionChanged="OnSettingChanged" />
                            <ComboBox x:Name="WasapiMmcssPriorityCombo" x:Uid="Settings_MmcssPriority" Width="360" SelectionChanged="OnSettingChanged" />
                            <NumberBox x:Name="WasapiPredecodeBox" x:Uid="Settings_Predecode" Width="320" HorizontalAlignment="Left" Minimum="1" Maximum="60"
                                       SpinButtonPlacementMode="Compact" ValueChanged="OnNumberChanged" />
                            <NumberBox x:Name="WasapiSilenceBox" x:Uid="Settings_FormatSilence" Width="320" HorizontalAlignment="Left" Minimum="0" Maximum="2000"
                                       SpinButtonPlacementMode="Compact" ValueChanged="OnNumberChanged" />
                            <NumberBox x:Name="WasapiReleaseBox" x:Uid="Settings_ReleaseAfterPause" Width="320" HorizontalAlignment="Left" Minimum="0" Maximum="3600"
                                       SpinButtonPlacementMode="Compact" ValueChanged="OnNumberChanged" />
                        </StackPanel>

                        <StackPanel x:Name="AsioGroup" Spacing="12">
                            <TextBlock Text="ASIO" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,8,0,0" />
                            <ComboBox x:Name="AsioDriverCombo" x:Uid="Settings_AsioDriver" Width="520" SelectionChanged="OnSettingChanged" />
                            <Button x:Uid="Settings_AsioPanel" Click="OnAsioPanelClick" />
                            <NumberBox x:Name="AsioBufferBox" x:Uid="Settings_AsioBuffer" Width="200" HorizontalAlignment="Left" Minimum="0" Maximum="65536"
                                       SpinButtonPlacementMode="Compact" ValueChanged="OnNumberChanged" />
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <NumberBox x:Name="AsioLeftBox" x:Uid="Settings_AsioLeft" Width="160" Minimum="1" Maximum="64"
                                           SpinButtonPlacementMode="Compact" ValueChanged="OnNumberChanged" />
                                <NumberBox x:Name="AsioRightBox" x:Uid="Settings_AsioRight" Width="160" Minimum="1" Maximum="64"
                                           SpinButtonPlacementMode="Compact" ValueChanged="OnNumberChanged" />
                            </StackPanel>
                            <ComboBox x:Name="AsioRateCombo" x:Uid="Settings_FixedRate" Width="360" SelectionChanged="OnSettingChanged" />
                            <NumberBox x:Name="AsioPredecodeBox" x:Uid="Settings_Predecode" Width="320" HorizontalAlignment="Left" Minimum="1" Maximum="60"
                                       SpinButtonPlacementMode="Compact" ValueChanged="OnNumberChanged" />
                            <NumberBox x:Name="AsioSilenceBox" x:Uid="Settings_FormatSilence" Width="320" HorizontalAlignment="Left" Minimum="0" Maximum="2000"
                                       SpinButtonPlacementMode="Compact" ValueChanged="OnNumberChanged" />
                            <NumberBox x:Name="AsioReleaseBox" x:Uid="Settings_ReleaseAfterPause" Width="320" HorizontalAlignment="Left" Minimum="0" Maximum="3600"
                                       SpinButtonPlacementMode="Compact" ValueChanged="OnNumberChanged" />
                        </StackPanel>

                        <StackPanel x:Name="KsGroup" Spacing="12">
                            <TextBlock Text="Kernel Streaming" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,8,0,0" />
                            <ComboBox x:Name="KsDeviceCombo" x:Uid="Settings_Device" Width="520" SelectionChanged="OnSettingChanged" />
                            <ComboBox x:Name="KsModeCombo" x:Uid="Settings_KsMode" Width="360" SelectionChanged="OnSettingChanged" />
                            <NumberBox x:Name="KsBufferBox" x:Uid="Settings_KsBuffer" Width="200" HorizontalAlignment="Left" Minimum="2" Maximum="1000"
                                       SpinButtonPlacementMode="Compact" ValueChanged="OnNumberChanged" />
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <NumberBox x:Name="KsPacketCountBox" x:Uid="Settings_KsPacketCount" Width="160" Minimum="2" Maximum="16"
                                           SpinButtonPlacementMode="Compact" ValueChanged="OnNumberChanged" />
                                <NumberBox x:Name="KsPacketMsBox" x:Uid="Settings_KsPacketMs" Width="160" Minimum="1" Maximum="200"
                                           SpinButtonPlacementMode="Compact" ValueChanged="OnNumberChanged" />
                            </StackPanel>
                            <ComboBox x:Name="KsFormatCombo" x:Uid="Settings_SampleFormat" Width="360" SelectionChanged="OnSettingChanged" />
                            <ComboBox x:Name="KsRateCombo" x:Uid="Settings_FixedRate" Width="360" SelectionChanged="OnSettingChanged" />
                            <ComboBox x:Name="KsMmcssTaskCombo" x:Uid="Settings_MmcssTask" Width="360" SelectionChanged="OnSettingChanged" />
                            <ComboBox x:Name="KsMmcssPriorityCombo" x:Uid="Settings_MmcssPriority" Width="360" SelectionChanged="OnSettingChanged" />
                            <NumberBox x:Name="KsPredecodeBox" x:Uid="Settings_Predecode" Width="320" HorizontalAlignment="Left" Minimum="1" Maximum="60"
                                       SpinButtonPlacementMode="Compact" ValueChanged="OnNumberChanged" />
                            <NumberBox x:Name="KsSilenceBox" x:Uid="Settings_FormatSilence" Width="320" HorizontalAlignment="Left" Minimum="0" Maximum="2000"
                                       SpinButtonPlacementMode="Compact" ValueChanged="OnNumberChanged" />
                            <NumberBox x:Name="KsReleaseBox" x:Uid="Settings_ReleaseAfterPause" Width="320" HorizontalAlignment="Left" Minimum="0" Maximum="3600"
                                       SpinButtonPlacementMode="Compact" ValueChanged="OnNumberChanged" />
                            <TextBlock x:Uid="Settings_KsNote" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <TextBlock x:Uid="Settings_ApplyNote" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Button x:Uid="Settings_Refresh" Click="OnRefreshDevicesClick" />

                        <TextBlock x:Uid="Settings_Status" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,8,0,0" />
                        <TextBlock x:Name="StatusText" TextWrapping="Wrap" IsTextSelectionEnabled="True" />

                        <TextBlock x:Uid="Settings_Interface" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,8,0,0" />
                        <ComboBox x:Name="LanguageCombo" x:Uid="Settings_Language" Width="360" SelectionChanged="OnLanguageChanged" />
                        <TextBlock x:Name="LanguageNote" x:Uid="Settings_LanguageNote" Visibility="Collapsed" TextWrapping="Wrap"
                                   Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
                <Grid x:Name="QueuePanel" Grid.Column="1" Visibility="Collapsed" Padding="16,16,8,16"
                      Background="{ThemeResource LayerFillColorDefaultBrush}"
                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1,0,0,0" RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid ColumnSpacing="8" Padding="0,0,8,0">
                        <Grid.Resources>
                            <SolidColorBrush x:Key="ButtonBackground" Color="Transparent" />
                            <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
                            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
                            <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
                        </Grid.Resources>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Uid="Queue_Title" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <TextBlock x:Name="QueueCountText" Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <Button Grid.Column="1" x:Uid="Queue_ClosePanel" Click="OnQueueToggleClick" Width="36" Height="36"
                                Padding="0" CornerRadius="18" VerticalAlignment="Top">
                            <FontIcon Glyph="&#xE711;" FontSize="14" />
                        </Button>
                    </Grid>
                    <ListView x:Name="QueueList" Grid.Row="1" SelectionMode="Single" CanDragItems="True" CanReorderItems="True"
                              DragItemsCompleted="OnQueueDragItemsCompleted" DoubleTapped="OnQueueDoubleTapped"
                              KeyDown="OnQueueKeyDown">
                        <ListView.Resources>
                            <SolidColorBrush x:Key="ButtonBackground" Color="Transparent" />
                            <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
                            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
                            <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
                        </ListView.Resources>
                    </ListView>
                    <TextBlock x:Name="QueueEmptyText" x:Uid="Queue_Empty" Grid.Row="1" TextWrapping="Wrap" Margin="0,0,8,0"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed" />
                    <StackPanel Grid.Row="2" Spacing="8" Padding="0,0,8,0">
                        <Button x:Uid="Queue_Clear" Click="OnQueueClearClick" HorizontalAlignment="Stretch" />
                        <Button x:Uid="Queue_Save" Click="OnQueueSaveClick" HorizontalAlignment="Stretch" />
                    </StackPanel>
                </Grid>
            </Grid>
        </NavigationView>

        <!-- Full-width playback bar (docs/Plan.md §8.1) -->
        <Grid Grid.Row="1" Padding="24,8,24,12" RowSpacing="4" Background="{ThemeResource LayerFillColorDefaultBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <InfoBar x:Name="ErrorBar" Severity="Warning" IsOpen="False" IsClosable="True" />
            <Grid Grid.Row="1" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Slider x:Name="PositionSlider" Minimum="0" Maximum="1" StepFrequency="0.1" IsThumbToolTipEnabled="False"
                        VerticalAlignment="Center" ValueChanged="OnSliderValueChanged" />
                <TextBlock x:Name="TimeText" Grid.Column="1" VerticalAlignment="Center" MinWidth="100" TextAlignment="Right" Text="0:00 / 0:00"
                           Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>
            <Grid Grid.Row="2" ColumnSpacing="8" VerticalAlignment="Center">
                <Grid.Resources>
                    <SolidColorBrush x:Key="ButtonBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
                    <SolidColorBrush x:Key="ToggleButtonBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="ToggleButtonBorderBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="ToggleButtonBorderBrushPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="ToggleButtonBorderBrushPressed" Color="Transparent" />
                    <Style x:Key="TransportButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                        <Setter Property="Width" Value="40" />
                        <Setter Property="Height" Value="40" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="CornerRadius" Value="20" />
                    </Style>
                    <Style x:Key="TransportToggleStyle" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
                        <Setter Property="Width" Value="40" />
                        <Setter Property="Height" Value="40" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="CornerRadius" Value="20" />
                    </Style>
                </Grid.Resources>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0" ColumnSpacing="8" MinWidth="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="68" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="CoverButton" Click="OnCoverClick" Padding="0"
                            Background="Transparent" BorderThickness="0" VerticalAlignment="Center">
                        <Grid Width="60" Height="60">
                            <FontIcon Glyph="&#xE93C;" FontSize="28" Opacity="0.4" />
                            <Image x:Name="PlaybackCover" Width="60" Height="60" Stretch="Uniform" />
                        </Grid>
                    </Button>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1" HorizontalAlignment="Stretch">
                        <TextBlock x:Name="TitleText" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                   MaxLines="1" FontSize="13" FontWeight="SemiBold" />
                        <HyperlinkButton x:Name="ArtistLink" Click="OnArtistLinkClick" Padding="0"
                                         HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Visibility="Collapsed">
                            <TextBlock x:Name="ArtistLinkText" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" MaxLines="1" />
                        </HyperlinkButton>
                        <HyperlinkButton x:Name="AlbumLink" Click="OnAlbumLinkClick" Padding="0"
                                         HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Visibility="Collapsed">
                            <TextBlock x:Name="AlbumLinkText" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" MaxLines="1" />
                        </HyperlinkButton>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="16,0,0,0">
                        <ToggleButton x:Name="ShuffleButton" Click="OnShuffleClick" Style="{StaticResource TransportToggleStyle}">
                            <SymbolIcon Symbol="Shuffle" />
                        </ToggleButton>
                        <Button x:Name="StopButton" Click="OnStopClick" Style="{StaticResource TransportButtonStyle}">
                            <SymbolIcon Symbol="Stop" />
                        </Button>
                        <Button x:Name="PreviousButton" Click="OnPreviousClick" Style="{StaticResource TransportButtonStyle}">
                            <SymbolIcon Symbol="Previous" />
                        </Button>
                    </StackPanel>
                </Grid>
                <Button x:Name="PlayPauseButton" Grid.Column="1" Click="OnPlayPauseClick" Style="{StaticResource AccentButtonStyle}"
                        Width="48" Height="48" Padding="0" CornerRadius="24" VerticalAlignment="Center">
                    <SymbolIcon x:Name="PlayPauseIcon" Symbol="Play" />
                </Button>
                <Grid Grid.Column="2" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button x:Name="NextButton" Click="OnNextClick" Style="{StaticResource TransportButtonStyle}">
                            <SymbolIcon Symbol="Next" />
                        </Button>
                        <Button x:Name="RepeatButton" Click="OnRepeatClick" Style="{StaticResource TransportButtonStyle}">
                            <SymbolIcon x:Name="RepeatIcon" Symbol="RepeatAll" />
                        </Button>
                    </StackPanel>
                    <ToggleButton x:Name="QueueToggleButton" Grid.Column="2" Click="OnQueueToggleClick"
                                  Style="{StaticResource TransportToggleStyle}" VerticalAlignment="Center">
                        <SymbolIcon Symbol="Bullets" />
                    </ToggleButton>
                </Grid>
            </Grid>
            <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8">
                <Ellipse x:Name="Lamp" Width="10" Height="10" VerticalAlignment="Center" Fill="{ThemeResource ControlStrongFillColorDisabledBrush}" />
                <TextBlock x:Name="LampText" VerticalAlignment="Center" FontWeight="SemiBold" />
                <TextBlock x:Name="FormatText" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="SourceText" Visibility="Collapsed" />
                <TextBlock x:Name="SignalPathText" Visibility="Collapsed" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
