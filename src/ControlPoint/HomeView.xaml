<!-- Home (docs/Plan.md §8.2): every row is filled from the Server off the UI thread and shows as many covers as fit. -->
<UserControl
    x:Class="CamelPlayer.HomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CamelPlayer">
    <UserControl.Resources>
        <Style x:Key="StatTileStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16,12" />
        </Style>
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource SubtitleTextBlockStyle}">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <DataTemplate x:Key="CoverTemplate" x:DataType="local:BrowseItem">
            <StackPanel Width="160" Spacing="2" Margin="0,0,12,0">
                <Border Width="160" Height="160" CornerRadius="8" Margin="0,0,0,6"
                        Background="{ThemeResource ControlFillColorSecondaryBrush}">
                    <Grid>
                        <FontIcon Glyph="&#xE93C;" FontSize="40" Opacity="0.4" />
                        <Image Stretch="UniformToFill" Loaded="OnCoverLoaded" Unloaded="OnCoverUnloaded" />
                    </Grid>
                </Border>
                <TextBlock Text="{x:Bind Title, Mode=OneWay}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                           Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock Text="{x:Bind Subtitle, Mode=OneWay}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                           Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="ArtistTemplate" x:DataType="local:BrowseItem">
            <Border Padding="12,6" CornerRadius="16" Background="{ThemeResource ControlFillColorSecondaryBrush}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE77B;" FontSize="14" />
                    <TextBlock Text="{x:Bind Title, Mode=OneWay}" />
                    <TextBlock Text="{x:Bind Subtitle, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>
        </DataTemplate>
        <!-- A ranked or played track: its rank or start time, title, artist and plays, listening time or time heard. -->
        <DataTemplate x:Key="TrackTemplate" x:DataType="local:BrowseItem">
            <Grid Padding="0,6" ColumnSpacing="16" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="Auto" MinWidth="0" />
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="Auto" MinWidth="72" />
                </Grid.ColumnDefinitions>
                <FontIcon x:Uid="Home_UnavailableIcon" Glyph="&#xE7BA;" FontSize="14" Visibility="{x:Bind IsUnavailable, Mode=OneWay}"
                          Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                <TextBlock Grid.Column="1" Text="{x:Bind Detail, Mode=OneWay}" VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Grid.Column="2" Text="{x:Bind Title, Mode=OneWay}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="3" Text="{x:Bind Subtitle, Mode=OneWay}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Grid.Column="4" Text="{x:Bind Trailing, Mode=OneWay}" VerticalAlignment="Center" TextAlignment="Right"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>
        </DataTemplate>
        <ItemsPanelTemplate x:Key="RowPanel">
            <ItemsStackPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="Sections" Spacing="12" Padding="0,0,16,24">
            <!-- The library's size, not a listening statistic, so it sits under the title rather than among the cards. -->
            <StackPanel>
                <TextBlock x:Uid="Home_Title" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock x:Name="LibraryCounts" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <Grid Margin="0,12,0,0">
                <TextBlock x:Uid="Home_RecentlyPlayed" Style="{StaticResource SectionHeaderStyle}" />
                <HyperlinkButton x:Uid="Home_ViewAll" Tag="played" Click="OnViewAllClick" HorizontalAlignment="Right" />
            </Grid>
            <TextBlock x:Name="PlayedEmpty" x:Uid="Home_NoPlays" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed" />
            <GridView x:Name="PlayedRow" ItemTemplate="{StaticResource CoverTemplate}" ItemsPanel="{StaticResource RowPanel}"
                      SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnAlbumClick"
                      ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                      ScrollViewer.VerticalScrollMode="Disabled" Height="250" SizeChanged="OnRowSizeChanged" />

            <Grid Margin="0,12,0,0">
                <TextBlock x:Uid="Home_RecentlyAdded" Style="{StaticResource SectionHeaderStyle}" />
                <HyperlinkButton x:Uid="Home_ViewAll" Tag="added" Click="OnViewAllClick" HorizontalAlignment="Right" />
            </Grid>
            <GridView x:Name="AddedRow" ItemTemplate="{StaticResource CoverTemplate}" ItemsPanel="{StaticResource RowPanel}"
                      SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnAlbumClick"
                      ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                      ScrollViewer.VerticalScrollMode="Disabled" Height="250" SizeChanged="OnRowSizeChanged" />

            <!-- Listening: a card picks the period that the chart, the most played and the history below show. -->
            <TextBlock x:Uid="Home_Listening" Style="{StaticResource SectionHeaderStyle}" Margin="0,12,0,0" />
            <Grid x:Name="Tiles" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource StatTileStyle}" Tag="today" Tapped="OnStatTileTapped">
                    <StackPanel>
                        <TextBlock x:Uid="Home_Today" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="TodayTime" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="WrapWholeWords" />
                        <TextBlock x:Name="TodayPlays" Style="{StaticResource CaptionTextBlockStyle}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource StatTileStyle}" Tag="week" Tapped="OnStatTileTapped">
                    <StackPanel>
                        <TextBlock x:Uid="Home_Week" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="WeekTime" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="WrapWholeWords" />
                        <TextBlock x:Name="WeekPlays" Style="{StaticResource CaptionTextBlockStyle}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource StatTileStyle}" Tag="month" Tapped="OnStatTileTapped">
                    <StackPanel>
                        <TextBlock x:Uid="Home_Month" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="MonthTime" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="WrapWholeWords" />
                        <TextBlock x:Name="MonthPlays" Style="{StaticResource CaptionTextBlockStyle}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="3" Style="{StaticResource StatTileStyle}" Tag="year" Tapped="OnStatTileTapped">
                    <StackPanel>
                        <TextBlock x:Uid="Home_Year" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="YearTime" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="WrapWholeWords" />
                        <TextBlock x:Name="YearPlays" Style="{StaticResource CaptionTextBlockStyle}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="4" Style="{StaticResource StatTileStyle}" Tag="all" Tapped="OnStatTileTapped">
                    <StackPanel>
                        <TextBlock x:Uid="Home_AllTime" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="AllTime" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="WrapWholeWords" />
                        <TextBlock x:Name="AllPlays" Style="{StaticResource CaptionTextBlockStyle}" />
                    </StackPanel>
                </Border>
            </Grid>
            <Border Style="{StaticResource StatTileStyle}" Height="190">
                <Grid RowSpacing="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Canvas x:Name="Chart" SizeChanged="OnChartSizeChanged" Background="Transparent" />
                    <Canvas x:Name="ChartAxis" Grid.Row="1" Height="16" />
                </Grid>
            </Border>
            <TextBlock x:Name="PeriodEmpty" x:Uid="Home_NoPlaysInPeriod" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed" />

            <StackPanel x:Name="PeriodLists" Spacing="12">
                <Grid Margin="0,12,0,0">
                    <TextBlock x:Uid="Home_MostPlayed" Style="{StaticResource SectionHeaderStyle}" />
                    <ComboBox x:Name="MetricCombo" x:Uid="Home_MetricCombo" MinWidth="110" HorizontalAlignment="Right" SelectionChanged="OnMetricChanged" />
                </Grid>

                <Grid>
                    <TextBlock x:Uid="Home_TopAlbums" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                    <HyperlinkButton x:Uid="Home_ViewAll" Tag="topAlbums" Click="OnViewAllClick" HorizontalAlignment="Right" />
                </Grid>
                <GridView x:Name="TopAlbumsRow" ItemTemplate="{StaticResource CoverTemplate}" ItemsPanel="{StaticResource RowPanel}"
                          SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnAlbumClick"
                          ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                          ScrollViewer.VerticalScrollMode="Disabled" Height="250" SizeChanged="OnRowSizeChanged" />

                <Grid>
                    <TextBlock x:Uid="Home_TopArtists" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                    <HyperlinkButton x:Uid="Home_ViewAll" Tag="topArtists" Click="OnViewAllClick" HorizontalAlignment="Right" />
                </Grid>
                <ListView x:Name="TopArtistsRow" ItemTemplate="{StaticResource ArtistTemplate}" ItemsPanel="{StaticResource RowPanel}"
                          SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnArtistClick"
                          ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                          ScrollViewer.VerticalScrollMode="Disabled" />

                <Grid>
                    <TextBlock x:Uid="Home_TopTracks" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                    <HyperlinkButton x:Uid="Home_ViewAll" Tag="topTracks" Click="OnViewAllClick" HorizontalAlignment="Right" />
                </Grid>
                <ListView x:Name="TopTracksList" ItemTemplate="{StaticResource TrackTemplate}" SelectionMode="None"
                          IsItemClickEnabled="True" ItemClick="OnTrackClick"
                          ScrollViewer.VerticalScrollMode="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" />

                <Grid Margin="0,12,0,0">
                    <TextBlock x:Name="HistoryHeader" Style="{StaticResource SectionHeaderStyle}" />
                    <HyperlinkButton x:Uid="Home_ViewAll" Tag="history" Click="OnViewAllClick" HorizontalAlignment="Right" />
                </Grid>
                <ListView x:Name="HistoryList" ItemTemplate="{StaticResource TrackTemplate}" SelectionMode="None"
                          IsItemClickEnabled="True" ItemClick="OnTrackClick"
                          ScrollViewer.VerticalScrollMode="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
