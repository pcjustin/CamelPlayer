namespace CamelPlayer {
// The cover edge a view's album cards share, so that a row of them fills its width.
[Microsoft.UI.Xaml.Data.Bindable]
[default_interface] runtimeclass CardSize : Microsoft.UI.Xaml.Data.INotifyPropertyChanged {
    CardSize();
    Double Cover;
}
} // namespace CamelPlayer
