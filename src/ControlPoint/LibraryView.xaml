<!-- Library pages (docs/Plan.md §8.2): every list is virtualized and filled from the Server off the UI thread. -->
<UserControl
    x:Class="CamelPlayer.LibraryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CamelPlayer">
    <UserControl.Resources>
        <SolidColorBrush x:Key="ButtonBackground" Color="Transparent" />
        <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
        <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
        <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
        <DataTemplate x:Key="RowTemplate" x:DataType="local:BrowseItem">
            <Grid Padding="0,6" ColumnSpacing="16" Background="Transparent" ContextRequested="OnRowContextRequested">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" MinWidth="56" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Bind Title, Mode=OneWay}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1" Text="{x:Bind Subtitle, Mode=OneWay}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Grid.Column="2" Text="{x:Bind Detail, Mode=OneWay}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4" Visibility="{x:Bind HasMarks, Mode=OneWay}"
                            PointerPressed="OnMarksPointer" PointerReleased="OnMarksPointer" DoubleTapped="OnMarksDoubleTapped">
                    <Button x:Uid="Marks_FavoriteButton" Click="OnFavoriteClick" Padding="6,4" VerticalAlignment="Center"
                            Background="Transparent" BorderThickness="0">
                        <FontIcon Glyph="{x:Bind FavoriteGlyph, Mode=OneWay}" FontSize="14" />
                    </Button>
                </StackPanel>
                <TextBlock Grid.Column="4" Text="{x:Bind Trailing, Mode=OneWay}" VerticalAlignment="Center" TextAlignment="Right"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>
        </DataTemplate>
        <!-- Folder pages list subfolders (a root also shows where it is) and then the folder's tracks. -->
        <DataTemplate x:Key="FolderRowTemplate" x:DataType="local:BrowseItem">
            <Grid Padding="0,6" Background="Transparent" ContextRequested="OnRowContextRequested">
                <Grid ColumnSpacing="16" Visibility="{x:Bind IsFolder, Mode=OneWay}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid>
                        <FontIcon Glyph="&#xE8B7;" FontSize="28" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Image x:Name="FolderCover" Width="40" Height="40" Stretch="UniformToFill" Loaded="OnArtworkLoaded"
                               Unloaded="OnArtworkUnloaded" DataContextChanged="OnArtworkContextChanged" />
                    </Grid>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind Title, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{x:Bind Subtitle, Mode=OneWay}" TextTrimming="CharacterEllipsis"
                                   Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Grid>
                <Grid ColumnSpacing="16" Visibility="{x:Bind IsTrack, Mode=OneWay}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="Auto" MinWidth="56" />
                    </Grid.ColumnDefinitions>
                    <Grid>
                        <FontIcon Glyph="&#xE8D6;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Image x:Name="TrackCover" Width="40" Height="40" Stretch="UniformToFill" Loaded="OnArtworkLoaded"
                               Unloaded="OnArtworkUnloaded" DataContextChanged="OnArtworkContextChanged" />
                    </Grid>
                    <TextBlock Grid.Column="1" Text="{x:Bind Title, Mode=OneWay}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="2" Text="{x:Bind Subtitle, Mode=OneWay}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Grid.Column="3" Text="{x:Bind Detail, Mode=OneWay}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Grid.Column="4" Text="{x:Bind Trailing, Mode=OneWay}" VerticalAlignment="Center" TextAlignment="Right"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="AlbumTemplate" x:DataType="local:BrowseItem">
            <StackPanel Width="176" Spacing="2" Padding="8" Background="Transparent" ContextRequested="OnCardContextRequested">
                <Border Width="160" Height="160" CornerRadius="8" Margin="0,0,0,6"
                        Background="{ThemeResource ControlFillColorSecondaryBrush}">
                    <Grid>
                        <FontIcon Glyph="&#xE93C;" FontSize="40" Opacity="0.4" />
                        <Image Stretch="UniformToFill" Loaded="OnArtworkLoaded" Unloaded="OnArtworkUnloaded"
                               DataContextChanged="OnArtworkContextChanged" />
                        <Border Visibility="{x:Bind IsFavorite, Mode=OneWay}" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                Margin="6" Padding="5" CornerRadius="12" Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}">
                            <FontIcon Glyph="&#xE00B;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        </Border>
                    </Grid>
                </Border>
                <TextBlock Text="{x:Bind Title, Mode=OneWay}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                           Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock Text="{x:Bind Subtitle, Mode=OneWay}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                           Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="BackButton" Click="OnBackClick" Visibility="Collapsed" VerticalAlignment="Center">
                <SymbolIcon Symbol="Back" />
            </Button>
            <Grid Grid.Column="1" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border CornerRadius="8" VerticalAlignment="Top">
                    <Image x:Name="DetailCover" Width="160" Height="160" Stretch="Uniform" Visibility="Collapsed" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="HeaderTitle" Style="{StaticResource TitleTextBlockStyle}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                    <TextBlock x:Name="HeaderDetail" TextWrapping="NoWrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                    <StackPanel x:Name="AlbumActions" Orientation="Horizontal" Spacing="8" Visibility="Collapsed" Margin="0,12,0,0">
                        <Button Style="{StaticResource AccentButtonStyle}" Padding="16,6">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE768;" FontSize="14" />
                                <TextBlock x:Uid="Library_AlbumPlaybackOptions" />
                                <FontIcon Glyph="&#xE70D;" FontSize="10" VerticalAlignment="Center" />
                            </StackPanel>
                            <Button.Flyout>
                                <MenuFlyout x:Name="AlbumMenu" Placement="BottomEdgeAlignedLeft">
                                    <MenuFlyoutItem x:Uid="Library_PlayAlbum" Click="OnPlayAlbumClick">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE768;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem x:Uid="Library_PlayAlbumNext" Click="OnPlayNextAlbumClick">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE893;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem x:Uid="Library_AddAlbum" Click="OnAddAlbumClick">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE710;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                        <ToggleButton x:Name="AlbumFavoriteButton" x:Uid="Marks_AlbumFavoriteButton" Click="OnAlbumFavoriteClick"
                                      Padding="10,6">
                            <FontIcon x:Name="AlbumFavoriteIcon" Glyph="&#xE006;" FontSize="16" />
                        </ToggleButton>
                    </StackPanel>
                    <BreadcrumbBar x:Name="FolderTrail" ItemClicked="OnTrailClicked" Visibility="Collapsed" Margin="0,4,0,0" />
                </StackPanel>
            </Grid>
            <ComboBox x:Name="SortCombo" Grid.Column="2" MinWidth="160" VerticalAlignment="Center" SelectionChanged="OnSortChanged" />
            <ToggleButton x:Name="DescendingToggle" Grid.Column="3" VerticalAlignment="Center" Click="OnDescendingClick">
                <SymbolIcon Symbol="Sort" />
            </ToggleButton>
        </Grid>

        <GridView x:Name="AlbumGrid" Grid.Row="1" ItemTemplate="{StaticResource AlbumTemplate}" SelectionMode="Extended"
                  IsItemClickEnabled="True" ItemClick="OnAlbumClick" Visibility="Collapsed" />
        <ListView x:Name="RowList" Grid.Row="1" ItemTemplate="{StaticResource RowTemplate}" SelectionMode="Extended"
                  IsItemClickEnabled="True" ItemClick="OnRowClick" Visibility="Collapsed">
            <ListView.Header>
                <!-- Search results (docs/Plan.md §8.2): album covers and artists above the matching tracks. -->
                <StackPanel x:Name="SearchGroups" Spacing="8" Padding="0,0,20,8" Visibility="Collapsed">
                    <Grid ColumnSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="SearchAlbumsHeader" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                        <Button Grid.Column="1" x:Uid="Search_ScrollBack" Tag="albums-back" Click="OnSearchRowScroll" Padding="6">
                            <FontIcon Glyph="&#xE76B;" FontSize="12" />
                        </Button>
                        <Button Grid.Column="2" x:Uid="Search_ScrollForward" Tag="albums-forward" Click="OnSearchRowScroll" Padding="6">
                            <FontIcon Glyph="&#xE76C;" FontSize="12" />
                        </Button>
                    </Grid>
                    <GridView x:Name="SearchAlbums" ItemTemplate="{StaticResource AlbumTemplate}" SelectionMode="None"
                              IsItemClickEnabled="True" ItemClick="OnAlbumClick" Height="250"
                              ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                              ScrollViewer.VerticalScrollMode="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                        <GridView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsStackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </GridView.ItemsPanel>
                    </GridView>
                    <Grid ColumnSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="SearchArtistsHeader" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                        <Button Grid.Column="1" x:Uid="Search_ScrollBack" Tag="artists-back" Click="OnSearchRowScroll" Padding="6">
                            <FontIcon Glyph="&#xE76B;" FontSize="12" />
                        </Button>
                        <Button Grid.Column="2" x:Uid="Search_ScrollForward" Tag="artists-forward" Click="OnSearchRowScroll" Padding="6">
                            <FontIcon Glyph="&#xE76C;" FontSize="12" />
                        </Button>
                    </Grid>
                    <ListView x:Name="SearchArtists" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnSearchArtistClick"
                              ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                              ScrollViewer.VerticalScrollMode="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                        <ListView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsStackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListView.ItemsPanel>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:BrowseItem">
                                <Border Padding="12,6" CornerRadius="16" Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                        Tag="artist" ContextRequested="OnCardContextRequested">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE77B;" FontSize="14" />
                                        <TextBlock Text="{x:Bind Title, Mode=OneWay}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock x:Name="SearchTracksHeader" Style="{StaticResource BodyStrongTextBlockStyle}" />
                </StackPanel>
            </ListView.Header>
        </ListView>
        <ListView x:Name="FolderList" Grid.Row="1" ItemTemplate="{StaticResource FolderRowTemplate}" SelectionMode="Extended"
                  IsItemClickEnabled="True" ItemClick="OnFolderItemClick" Visibility="Collapsed" />
        <TextBlock x:Name="EmptyText" Grid.Row="1" TextWrapping="Wrap" Visibility="Collapsed"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
    </Grid>
</UserControl>
