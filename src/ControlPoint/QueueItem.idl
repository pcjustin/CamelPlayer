namespace CamelPlayer {
// One row of the queue panel; refilled in place when the current entry changes.
[default_interface] runtimeclass QueueItem : Microsoft.UI.Xaml.Data.INotifyPropertyChanged {
    String Title { get; };
    String Path { get; };
    Boolean IsCurrent { get; };
    Boolean IsNotCurrent { get; };
    String RemoveLabel { get; };
}
} // namespace CamelPlayer
