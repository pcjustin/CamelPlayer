namespace CamelPlayer {
// One row or tile of a library view; a placeholder until its page arrives, then filled in place.
[default_interface] runtimeclass BrowseItem : Microsoft.UI.Xaml.Data.INotifyPropertyChanged, Windows.Foundation.IStringable {
    String Title { get; };
    String Subtitle { get; };
    String Detail { get; };
    String Trailing { get; }; // right-aligned: a duration or a count
    Boolean IsFolder { get; };
    Boolean IsTrack { get; };
    Boolean IsUnavailable { get; };
    Boolean HasMarks { get; }; // shows a track's heart
    Boolean IsFavorite { get; };
    String FavoriteGlyph { get; };
    Boolean HasAvatar { get; }; // an artist or composer row: their picture, or their initial on AvatarBrush
    String Initial { get; };
    Microsoft.UI.Xaml.Media.Brush AvatarBrush { get; };
    Microsoft.UI.Xaml.Thickness Indent { get; }; // a folder tree row's depth
    String ChevronGlyph { get; };                // an open or closed folder in the tree; none for a track
    String TreeGlyph { get; };                   // a folder or a note
}
} // namespace CamelPlayer
