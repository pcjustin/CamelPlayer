namespace CamelPlayer {
// One row or tile of a library view; a placeholder until its page arrives, then filled in place.
[default_interface] runtimeclass BrowseItem : Microsoft.UI.Xaml.Data.INotifyPropertyChanged {
    String Title { get; };
    String Subtitle { get; };
    String Detail { get; };
    String Trailing { get; }; // right-aligned: a duration or a count
    Boolean IsFolder { get; };
    Boolean IsTrack { get; };
}
} // namespace CamelPlayer
