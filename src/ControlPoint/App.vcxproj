    </ClCompile>
    <ClCompile Include="LibraryView.xaml.cpp">
      <DependentUpon>LibraryView.xaml</DependentUpon>
    </ClCompile>
    <ClCompile Include="HomeView.xaml.cpp">
      <DependentUpon>HomeView.xaml</DependentUpon>
    </ClCompile>
    <ClCompile Include="PlaylistView.xaml.cpp">
      <DependentUpon>PlaylistView.xaml</DependentUpon>
    </ClCompile>
    <ClCompile Include="$(GeneratedFilesDir)module.g.cpp" />
  </ItemGroup>
  <ItemGroup>
    <Midl Include="MainWindow.idl">
      <SubType>Code</SubType>
      <DependentUpon>MainWindow.xaml</DependentUpon>
    </Midl>
    <Midl Include="BrowseItem.idl" />
    <Midl Include="QueueItem.idl" />
    <Midl Include="LibraryView.idl">
      <SubType>Code</SubType>
      <DependentUpon>LibraryView.xaml</DependentUpon>
    </Midl>
    <Midl Include="HomeView.idl">
      <SubType>Code</SubType>
      <DependentUpon>HomeView.xaml</DependentUpon>
    </Midl>
    <Midl Include="PlaylistView.idl">
      <SubType>Code</SubType>
      <DependentUpon>PlaylistView.xaml</DependentUpon>
    </Midl>
  </ItemGroup>
  <ItemGroup>
    <ResourceCompile Include="App.rc" />
  </ItemGroup>
  <ItemGroup>
    <PRIResource Include="Strings\en-US\Resources.resw" />
    <PRIResource Include="Strings\zh-TW\Resources.resw" />
  </ItemGroup>
  <ItemGroup>
    <None Include="packages.config" />
