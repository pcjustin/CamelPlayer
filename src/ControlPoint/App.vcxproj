  <Import Project="$(CamelPackages)Microsoft.WindowsAppSDK.Base.1.8.251216001\build\native\Microsoft.WindowsAppSDK.Base.props" Condition="Exists('$(CamelPackages)Microsoft.WindowsAppSDK.Base.1.8.251216001\build\native\Microsoft.WindowsAppSDK.Base.props')" />
  <Import Project="$(CamelPackages)Microsoft.WindowsAppSDK.InteractiveExperiences.1.8.260708001\build\native\Microsoft.WindowsAppSDK.InteractiveExperiences.props" Condition="Exists('$(CamelPackages)Microsoft.WindowsAppSDK.InteractiveExperiences.1.8.260708001\build\native\Microsoft.WindowsAppSDK.InteractiveExperiences.props')" />
  <Import Project="$(CamelPackages)Microsoft.WindowsAppSDK.Foundation.1.8.260803002\build\native\Microsoft.WindowsAppSDK.Foundation.props" Condition="Exists('$(CamelPackages)Microsoft.WindowsAppSDK.Foundation.1.8.260803002\build\native\Microsoft.WindowsAppSDK.Foundation.props')" />
  <Import Project="$(CamelPackages)Microsoft.WindowsAppSDK.WinUI.1.8.260803003\build\native\Microsoft.WindowsAppSDK.WinUI.props" Condition="Exists('$(CamelPackages)Microsoft.WindowsAppSDK.WinUI.1.8.260803003\build\native\Microsoft.WindowsAppSDK.WinUI.props')" />
  <Import Project="$(CamelPackages)Microsoft.WindowsAppSDK.DWrite.1.8.25122902\build\Microsoft.WindowsAppSDK.DWrite.props" Condition="Exists('$(CamelPackages)Microsoft.WindowsAppSDK.DWrite.1.8.25122902\build\Microsoft.WindowsAppSDK.DWrite.props')" />
  <Import Project="$(CamelPackages)Microsoft.WindowsAppSDK.Runtime.1.8.260921001\build\native\Microsoft.WindowsAppSDK.Runtime.props" Condition="Exists('$(CamelPackages)Microsoft.WindowsAppSDK.Runtime.1.8.260921001\build\native\Microsoft.WindowsAppSDK.Runtime.props')" />
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <DesktopCompatible>true</DesktopCompatible>
    <UseDebugLibraries Condition="'$(Configuration)'=='Debug'">true</UseDebugLibraries>
    <UseDebugLibraries Condition="'$(Configuration)'=='Release'">false</UseDebugLibraries>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <Import Project="$(CamelRoot)msbuild\CamelPlayer.Cpp.props" />
  <Import Project="$(CamelRoot)msbuild\CamelPlayer.CoreLink.props" />
  <PropertyGroup>
    <TargetName>CamelPlayer</TargetName>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <PrecompiledHeader>Use</PrecompiledHeader>
      <PrecompiledHeaderFile>pch.h</PrecompiledHeaderFile>
      <PrecompiledHeaderOutputFile>$(IntDir)pch.pch</PrecompiledHeaderOutputFile>
      <AdditionalOptions>%(AdditionalOptions) /bigobj</AdditionalOptions>
      <!-- our own wWinMain (Main.cpp) sets the UI language before XAML starts -->
      <PreprocessorDefinitions>DISABLE_XAML_GENERATED_MAIN;CAMEL_VERSION=$(CamelVersion);%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <!-- XAML-generated code trips some /W4 warnings -->
      <DisableSpecificWarnings>4100;4189;%(DisableSpecificWarnings)</DisableSpecificWarnings>
    </ClCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <AdditionalDependencies>dbghelp.lib;shell32.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <!-- per-library size breakdown for docs/Decoder-comparison.md -->
      <GenerateMapFile>true</GenerateMapFile>
      <MapFileName>$(IntDir)$(TargetName).map</MapFileName>
    </Link>
  </ItemDefinitionGroup>
  <ItemGroup>
    <Manifest Include="app.manifest" />
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="pch.h" />
    <ClInclude Include="App.xaml.h">
