      <Link>assets\CamelPlayer.ico</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Automatic updates (docs/Plan.md §8.6): the updater and the changelog shown after an update. -->
