    <ProjectGuid>{6B0F6E0A-5C1D-4E52-9A39-3D0C2C8E1A05}</ProjectGuid>
    <ProjectName>App</ProjectName>
    <RootNamespace>CamelPlayer</RootNamespace>
    <DefaultLanguage>en-US</DefaultLanguage>
    <AppContainerApplication>false</AppContainerApplication>
    <AppxPackage>false</AppxPackage>
    <ApplicationType>Windows Store</ApplicationType>
    <ApplicationTypeRevision>10.0</ApplicationTypeRevision>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <WindowsAppSDKVerifyTransitiveDependencies>false</WindowsAppSDKVerifyTransitiveDependencies>
    <CamelPackages>$(MSBuildThisFileDirectory)..\..\packages\</CamelPackages>
  </PropertyGroup>
  <Import Project="$(CamelPackages)Microsoft.Windows.CppWinRT.2.0.250303.1\build\native\Microsoft.Windows.CppWinRT.props" Condition="Exists('$(CamelPackages)Microsoft.Windows.CppWinRT.2.0.250303.1\build\native\Microsoft.Windows.CppWinRT.props')" />
