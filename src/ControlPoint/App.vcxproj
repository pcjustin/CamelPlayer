    <ClInclude Include="PlaylistCollection.h" />
    <ClInclude Include="PlaylistView.xaml.h">
      <DependentUpon>PlaylistView.xaml</DependentUpon>
    </ClInclude>
  </ItemGroup>
  <ItemGroup>
    <ApplicationDefinition Include="App.xaml" />
