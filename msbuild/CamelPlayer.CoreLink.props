<Project>
  <!-- Imported by executables that link the native modules (App, camelcli, tests), after CamelPlayer.Cpp.props. -->
  <ItemGroup>
    <ProjectReference Include="$(CamelRoot)src\Common\Common.vcxproj">
      <Project>{6B0F6E0A-5C1D-4E52-9A39-3D0C2C8E1A10}</Project>
    </ProjectReference>
    <ProjectReference Include="$(CamelRoot)src\OutputBridge\OutputBridge.vcxproj">
      <Project>{6B0F6E0A-5C1D-4E52-9A39-3D0C2C8E1A11}</Project>
    </ProjectReference>
    <ProjectReference Include="$(CamelRoot)src\Engine\Engine.vcxproj">
      <Project>{6B0F6E0A-5C1D-4E52-9A39-3D0C2C8E1A12}</Project>
    </ProjectReference>
    <ProjectReference Include="$(CamelRoot)src\Server\Server.vcxproj">
      <Project>{6B0F6E0A-5C1D-4E52-9A39-3D0C2C8E1A13}</Project>
    </ProjectReference>
    <ProjectReference Include="$(CamelRoot)rust\symphonia_ffi\symphonia_ffi.vcxproj">
      <Project>{6B0F6E0A-5C1D-4E52-9A39-3D0C2C8E1A02}</Project>
      <LinkLibraryDependencies>false</LinkLibraryDependencies>
    </ProjectReference>
  </ItemGroup>
  <ItemDefinitionGroup>
    <Link>
      <AdditionalDependencies>$(CamelRoot)build\cargo\release\symphonia_ffi.lib;windowscodecs.lib;libwebp.lib;ws2_32.lib;userenv.lib;ntdll.lib;bcrypt.lib;advapi32.lib;ole32.lib;oleaut32.lib;uuid.lib;avrt.lib;winmm.lib;setupapi.lib;cfgmgr32.lib;secur32.lib;ncrypt.lib;crypt32.lib;mfuuid.lib;strmiids.lib;shlwapi.lib;winhttp.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)' == 'Debug'">
    <Link>
      <!-- symphonia_ffi.lib is always built against the release CRT -->
      <IgnoreSpecificDefaultLibraries>msvcrt.lib;%(IgnoreSpecificDefaultLibraries)</IgnoreSpecificDefaultLibraries>
    </Link>
  </ItemDefinitionGroup>
</Project>
