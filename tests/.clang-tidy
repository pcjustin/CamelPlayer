# gtest misfires these: TEST registers each test at static initialization, which may throw; the dataflow of
# unchecked-optional-access does not follow ASSERT_TRUE(optional); and the gtest macros use std::tuple_size<>::value.
InheritParentConfig: true
Checks: >
  -bugprone-throwing-static-initialization,
  -bugprone-unchecked-optional-access
CheckOptions:
  modernize-type-traits.IgnoreMacros: true
