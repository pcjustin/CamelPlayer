root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{md,json,yml,yaml,xml,props,targets,vcxproj,filters,xaml,resw,config}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.rs]
end_of_line = lf
