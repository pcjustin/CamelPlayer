# Windows SDK code includes <windows.h>, not the headers it is split into, and every Control point source must
# start with its precompiled pch.h.
Diagnostics:
  UnusedIncludes: Strict
  MissingIncludes: Strict
  Includes:
    IgnoreHeader:
      - 'Windows Kits/10/Include/.*'
      - 'pch\.h'
